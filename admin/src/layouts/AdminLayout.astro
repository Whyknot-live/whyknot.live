---
export interface Props {
  title?: string;
  description?: string;
}

const { title = "Admin Dashboard", description = "WhyKnot Admin Panel" } =
  Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} | WhyKnot Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      rel="icon"
      type="image/png"
      href="/images/logo-y-knot-transparent.png"
    />
    <link rel="apple-touch-icon" href="/images/logo-y-knot-transparent.png" />
    <style is:global>
      @import "../styles/admin.css";
      @import "../styles/admin-nav.css";
    </style>
  </head>
  <body>
    <!-- Theme initialization script -->
    <script is:inline>
      (function () {
        const savedTheme = localStorage.getItem("theme");
        const systemPrefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches;

        let theme;
        if (savedTheme && (savedTheme === "light" || savedTheme === "dark")) {
          theme = savedTheme;
        } else {
          theme = systemPrefersDark ? "dark" : "light";
        }

        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>

    <!-- Admin API initialization - must run before page scripts -->
    <script is:inline>
      (function() {
        function isLocalhostOrigin(origin) {
          try {
            const url = new URL(origin);
            if (url.hostname === "localhost") {
              return true;
            }
            return url.hostname.startsWith("127.") || url.hostname === "[::1]";
          } catch (e) {
            return false;
          }
        }

        function resolveApiBaseUrl() {
          // For development, use localhost with port 9000
          if (isLocalhostOrigin(window.location.origin)) {
            return "http://localhost:9000/api";
          }
          
          // In production, always use the custom API domain
          // The Render subdomain (api-whyknot-live.onrender.com) redirects to the custom domain,
          // which breaks CORS. So we always use the custom domain directly.
          return "https://api.whyknot.live/api";
        }

        let adminBaseURL;
        try {
          adminBaseURL = resolveApiBaseUrl();
        } catch (error) {
          console.error(error);
          document.body.innerHTML =
            '<main class="config-error"><h1>Configuration error</h1><p>Admin API URL is not configured.</p></main>';
          throw error;
        }

        // Global admin utilities
        window.adminAPI = {
          baseURL: adminBaseURL,

          getToken() {
            return null; // Cookie-based auth, no token
          },

          setToken() {
            // No-op for cookie-based auth
          },

          clearToken() {
            // No-op for cookie-based auth
          },

          // Check if authenticated by verifying with backend (graceful - no 401 errors)
          isAuthenticated() {
            return fetch(`${this.baseURL}/admin/check`, {
              method: "GET",
              credentials: "include"
            })
              .then((response) => {
                if (!response.ok) return false;
                return response.json();
              })
              .then((data) => data && data.authenticated === true)
              .catch(() => false);
          },

          fetch(endpoint, options = {}) {
            const headers = Object.assign(
              { "Content-Type": "application/json" },
              options.headers || {}
            );

            return fetch(this.baseURL + endpoint, Object.assign({}, options, {
              headers: headers,
              credentials: "include"
            })).then((response) => {
              if (response.status === 401) {
                window.location.href = "/";
                throw new Error("Unauthorized");
              }
              return response;
            });
          },

          logout() {
            return this.fetch("/admin/logout", { method: "POST" })
              .catch(() => {
                // Ignore errors
              })
              .then(() => {
                window.location.href = "/";
              });
          }
        };
      })();
    </script>

    <!-- Section nav: hidden by default, un-hidden below on every route except
         the login screen, so unauthenticated visitors never see it. -->
    <nav id="adminNav" class="admin-nav" aria-label="Admin sections" hidden>
      <a href="/dashboard">Dashboard</a>
      <a href="/claims">Claims</a>
      <a href="/submissions">Submissions</a>
    </nav>

    <script is:inline>
      (function () {
        const path = window.location.pathname
          .replace(/\/index\.html$/, "")
          .replace(/\.html$/, "")
          .replace(/\/$/, "");
        if (path === "" || path === "/") return; // login route
        const nav = document.getElementById("adminNav");
        if (!nav) return;
        const links = nav.querySelectorAll("a");
        for (let i = 0; i < links.length; i++) {
          if (links[i].getAttribute("href") === path) {
            links[i].setAttribute("aria-current", "page");
          }
        }
        nav.hidden = false;
      })();
    </script>

    <slot />
  </body>
</html>
