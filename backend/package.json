{
    "name": "whyknot-backend",
    "version": "0.1.0",
    "private": true,
    "main": "dist/index.js",
    "scripts": {
        "dev": "bun --watch src/index.ts",
        "build": "bun build --compile --minify --sourcemap src/index.ts --outfile whyknot-backend",
        "start": "NODE_ENV=production bun run src/index.ts",
        "typecheck": "tsc --noEmit",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "lint:type-aware": "oxlint --type-aware",
        "test": "bun test src/tests/**/*.test.ts"
    },
    "engines": {
        "bun": ">=1.3.1",
        "node": ">=22.0.0"
    },
    "packageManager": "bun@1.3.14",
    "dependencies": {
        "bcrypt": "^6.0.0",
        "dotenv": "^17.2.3",
        "hono": "^4.10.7",
        "mongodb": "^7.0.0",
        "nodemailer": "^7.0.11",
        "razorpay": "^2.9.8",
        "redis": "^5.10.0",
        "resend": "^6.5.2",
        "socks": "^2.8.7",
        "zod": "^4.1.13"
    },
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/node": "^24.10.1",
        "@types/nodemailer": "^7.0.4",
        "@types/redis": "^4.0.11",
        "oxlint": "^1.80.0",
        "oxlint-tsgolint": "^7.0.2001",
        "tsx": "^4.21.0",
        "typescript": "^7.0.2"
    }
}