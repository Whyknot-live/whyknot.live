{
    "name": "whyknot-frontend",
    "type": "module",
    "private": true,
    "version": "0.0.1",
    "engines": {
        "node": ">=22.0.0",
        "bun": ">=1.3.1"
    },
    "packageManager": "bun@1.3.14",
    "scripts": {
        "dev": "astro dev",
        "start": "astro preview",
        "build": "astro build",
        "build:production": "NODE_ENV=production astro build",
        "preview": "astro preview",
        "check": "astro check",
        "typecheck": "tsc --noEmit",
        "lint": "oxlint && bun scripts/check-tokens.mjs",
        "lint:fix": "oxlint --fix",
        "lint:type-aware": "oxlint --type-aware",
        "analyze": "astro build --verbose"
    },
    "dependencies": {
        "@astrojs/check": "0.9.6",
        "@astrojs/react": "4.4.2",
        "astro": "5.16.4",
        "dompurify": "^3.3.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "three": "^0.186.0",
        "typescript": "^7.0.2"
    },
    "devDependencies": {
        "@types/dompurify": "^3.2.0",
        "@types/node": "^24.10.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/three": "^0.185.4",
        "oxlint": "^1.80.0",
        "oxlint-tsgolint": "^7.0.2001"
    }
}
