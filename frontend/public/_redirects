# Redirect rules for Render static site
# See https://docs.render.com/redirects-rewrites

# Redirect non-www to www (canonical domain)
https://whyknot.live/* https://www.whyknot.live/:splat 301!
http://whyknot.live/* https://www.whyknot.live/:splat 301!
http://www.whyknot.live/* https://www.whyknot.live/:splat 301!

# Screener reports are minted live at scan time (scan_<id>), so their ids are
# unknown at build. Serve the single prerendered shell for any report id; the
# page reads the id from the URL and fetches the audit client-side. A rewrite
# (no status code) keeps the URL intact. Unknown/expired ids show an empty state.
/screener/report/*    /screener/report/index    200

# 404 fallback - serve the custom 404 page for unknown routes
/*    /404.html   404
