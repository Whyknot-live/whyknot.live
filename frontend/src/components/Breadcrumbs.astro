---
/* Breadcrumbs — depth ≥3 pages (profiles, reports, dashboard). */
export interface Crumb {
    label: string;
    href?: string;
}

export interface Props {
    trail: Crumb[];
}

const { trail } = Astro.props;
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/">
        <svg class="knot-tick" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path
                d="M7 17 C 4 13 5 7 10 6 C 15 5 19 8 18 12 C 17 15 13 16 11 14 C 10 12 11 10 13 10 C 16 10 18 12 19 15"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
            />
        </svg>
        whyknot
    </a>
    {trail.map((crumb) => (
        <>
            <span class="crumb-sep" aria-hidden="true">/</span>
            {crumb.href ? <a href={crumb.href}>{crumb.label}</a> : <span aria-current="page">{crumb.label}</span>}
        </>
    ))}
</nav>
