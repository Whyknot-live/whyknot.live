---
/* Drawer — side panel on desktop, bottom sheet on mobile (see .drawer CSS).
   Open with <button data-drawer-open="id">. */
import Icon from './Icon.astro';

export interface Props {
    id: string;
    title: string;
}

const { id, title } = Astro.props;
---

<aside class="drawer" id={id} role="dialog" aria-modal="true" aria-labelledby={`${id}-title`} aria-hidden="true" inert data-drawer tabindex="-1">
    <div class="modal-head">
        <h2 id={`${id}-title`}>{title}</h2>
        <button type="button" class="modal-x" data-drawer-close aria-label={`Close ${title}`}><Icon name="close" size="sm" /></button>
    </div>
    <div class="modal-body">
        <slot />
    </div>
</aside>

<script>
    function initDrawers() {
        const FOCUSABLE = 'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';

        function lockScroll() {
            const count = Number(document.documentElement.getAttribute('data-wk-locks') ?? '0');
            document.documentElement.setAttribute('data-wk-locks', String(count + 1));
            document.documentElement.style.overflow = 'hidden';
        }

        function unlockScroll() {
            const count = Number(document.documentElement.getAttribute('data-wk-locks') ?? '0');
            if (count <= 1) {
                document.documentElement.removeAttribute('data-wk-locks');
                document.documentElement.style.overflow = '';
            } else {
                document.documentElement.setAttribute('data-wk-locks', String(count - 1));
            }
        }

        const open = (drawer, trigger) => {
            if (drawer.getAttribute('data-drawer-state') === 'open') return;
            drawer.setAttribute('data-drawer-state', 'open');
            drawer.wkTrigger = trigger ?? document.activeElement ?? null;
            drawer.classList.add('open');
            drawer.setAttribute('aria-hidden', 'false');
            drawer.removeAttribute('inert');
            lockScroll();
            const target = drawer.querySelector(FOCUSABLE);
            if (target instanceof HTMLElement) target.focus({ preventScroll: true });
            else drawer.focus({ preventScroll: true });
        };

        const close = (drawer) => {
            if (drawer.getAttribute('data-drawer-state') !== 'open') return;
            drawer.removeAttribute('data-drawer-state');
            drawer.classList.remove('open');
            drawer.setAttribute('aria-hidden', 'true');
            drawer.setAttribute('inert', '');
            unlockScroll();
            const trigger = drawer.wkTrigger;
            drawer.wkTrigger = null;
            if (trigger instanceof HTMLElement && trigger.isConnected) trigger.focus({ preventScroll: true });
        };

        const trapTab = (event, drawer) => {
            const items = Array.from(drawer.querySelectorAll(FOCUSABLE)).filter(
                (el) => el instanceof HTMLElement && !el.hidden && el.getClientRects().length > 0
            );
            if (items.length === 0) {
                event.preventDefault();
                drawer.focus({ preventScroll: true });
                return;
            }
            const first = items[0];
            const last = items[items.length - 1];
            if (event.shiftKey && document.activeElement === first) {
                event.preventDefault();
                last.focus();
            } else if (!event.shiftKey && document.activeElement === last) {
                event.preventDefault();
                first.focus();
            }
        };

        document.querySelectorAll('[data-drawer-open]:not([data-wired])').forEach((trigger) => {
            trigger.setAttribute('data-wired', 'true');
            trigger.addEventListener('click', () => {
                const drawer = document.getElementById(trigger.getAttribute('data-drawer-open') ?? '');
                if (!(drawer instanceof HTMLElement)) return;
                open(drawer, trigger);
            });
        });
        document.querySelectorAll('[data-drawer]:not([data-wired])').forEach((drawer) => {
            drawer.setAttribute('data-wired', 'true');
            drawer.querySelectorAll('[data-drawer-close]').forEach((btn) => {
                btn.addEventListener('click', () => close(drawer));
            });
            drawer.addEventListener('keydown', (event) => {
                if (event.key === 'Escape') {
                    close(drawer);
                    return;
                }
                if (event.key === 'Tab') trapTab(event, drawer);
            });
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initDrawers);
    } else {
        initDrawers();
    }
    document.addEventListener('astro:page-load', initDrawers);
</script>
