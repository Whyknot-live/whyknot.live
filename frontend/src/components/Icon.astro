---
/* Icon — single-source SVG set for WhyKnot's knot taste.
   24-grid, 2px round-cap strokes, currentColor. Filled glyphs (star, boost,
   moon-dot) are the only fill exceptions. Sizes come from props so pages stop
   hard-coding 11/14/15/16/18/20/32 widths ad hoc.
   Paths live in one lookup table and render via set:html (trusted static
   strings, never user input). */
export type IconName = 'sun' | 'moon' | 'chevron-down' | 'close' | 'arrow-right' | 'arrow-left' | 'check' | 'alert' | 'shield' | 'clock' | 'search' | 'eye' | 'star' | 'spinner' | 'knot' | 'boost' | 'trend-up' | 'trend-down' | 'mail' | 'message' | 'file' | 'help' | 'users' | 'layers' | 'zap';

export interface Props {
    name: IconName;
    size?: 'xs' | 'sm' | 'md' | 'lg' | 'xl' | number;
    label?: string;
    className?: string;
}

const { name, size = 'md', label, className = '' } = Astro.props;

const SIZES: Record<string, number> = { xs: 12, sm: 14, md: 16, lg: 20, xl: 24 };
const px = typeof size === 'number' ? size : (SIZES[size] ?? 16);

const PATHS: Record<IconName, string> = {
    sun: '<circle cx="12" cy="12" r="4.2"/><path d="M12 2.8v2.4M12 18.8v2.4M2.8 12h2.4M18.8 12h2.4M5.2 5.2l1.7 1.7M17.1 17.1l1.7 1.7M18.8 5.2l-1.7 1.7M6.9 17.1l-1.7 1.7"/>',
    moon: '<path d="M20 14.5A8.5 8.5 0 0 1 9.5 4 7 7 0 1 0 20 14.5Z"/><circle cx="17.4" cy="5.6" r="1.2" fill="currentColor" stroke="none"/>',
    'chevron-down': '<path d="M5 9.5 12 16.5 19 9.5"/>',
    close: '<path d="M6 6l12 12M18 6 6 18"/>',
    'arrow-right': '<path d="M4 12h15"/><path d="M13.5 6.5 19 12l-5.5 5.5"/>',
    'arrow-left': '<path d="M20 12H5"/><path d="M10.5 6.5 5 12l5.5 5.5"/>',
    check: '<path d="M4.5 12.5 10 18 19.5 6.5"/>',
    alert: '<circle cx="12" cy="12" r="9"/><path d="M12 7.5V12.5"/><path d="M12 16.2v.3"/>',
    shield: '<path d="M12 3 5 5.8v5.4c0 4.4 3 7.6 7 9.8 4-2.2 7-5.4 7-9.8V5.8Z"/>',
    clock: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2.5"/>',
    search: '<circle cx="11" cy="11" r="7"/><path d="M16.2 16.2 20.5 20.5"/>',
    eye: '<path d="M2.5 12S6 5.8 12 5.8 21.5 12 21.5 12 18 18.2 12 18.2 2.5 12 2.5 12Z"/><circle cx="12" cy="12" r="2.8"/>',
    star: '<path d="M12 2.8 14.9 8.6 21.2 9.5 16.6 14 17.7 20.3 12 17.2 6.3 20.3 7.4 14 2.8 9.5 9.1 8.6Z" fill="currentColor" stroke="none"/>',
    spinner: '<circle cx="12" cy="12" r="9" opacity="0.2"/><path d="M21 12a9 9 0 0 0-9-9"/>',
    knot: '<path d="M7 17 C 4 13 5 7 10 6 C 15 5 19 8 18 12 C 17 15 13 16 11 14 C 10 12 11 10 13 10 C 16 10 18 12 19 15"/>',
    boost: '<path d="M8 2.5 14 10H2 Z" fill="currentColor" stroke="none"/><rect x="4.5" y="10.5" width="7" height="2.4" rx="1.2" fill="currentColor" stroke="none"/>',
    'trend-up': '<path d="M3.5 17.5 9.5 11.5 13 15l7.5-7.5"/><path d="M15 7.5h5.5V13"/>',
    'trend-down': '<path d="M3.5 6.5l6 6L13 9l7.5 7.5"/><path d="M15 16.5h5.5V11"/>',
    mail: '<rect x="3" y="5.5" width="18" height="13" rx="2"/><path d="M4 7.5 12 13l8-5.5"/>',
    message: '<path d="M12 20l-3-3H6a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4h12a4 4 0 0 1 4 4v6a4 4 0 0 1-4 4h-3Z"/>',
    file: '<path d="M13.5 3.5H7a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-9Z"/><path d="M13.5 3.5v6h6"/>',
    help: '<circle cx="12" cy="12" r="8.5"/><path d="M9.6 9.2A2.6 2.6 0 0 1 12 7.8c1.4 0 2.6 1 2.6 2.3 0 1.8-2.4 2.1-2.4 3.7"/><path d="M12 16.8v.3"/>',
    users: '<circle cx="9" cy="8" r="3.5"/><path d="M3.5 19.5c.6-3.2 2.8-5 5.5-5s4.9 1.8 5.5 5"/><path d="M15.5 5.2a3.5 3.5 0 0 1 0 5.6"/><path d="M17.5 14.9c1.7.7 2.8 2.3 3 4.6"/>',
    layers: '<path d="M12 3 3 8l9 5 9-5Z"/><path d="M3.5 12.5 12 17l8.5-4.5"/><path d="M3.5 16.5 12 21l8.5-4.5"/>',
    zap: '<path d="M13 2.5 4.5 13.5H11l-1 8 8.5-11H12Z"/>',
};

const body = PATHS[name] ?? '';
---

<svg
    class={`wk-icon wk-icon--${name} ${className}`.trim()}
    width={px}
    height={px}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden={label ? undefined : 'true'}
    role={label ? 'img' : undefined}
    aria-label={label}
    focusable="false"
    set:html={body}
>
</svg>
