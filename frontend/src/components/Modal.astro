---
/* Modal — custom div dialog with zero native chrome.
   Open declaratively with <button data-modal-open="id"> (id targets the panel).
   Styling lives in src/styles/components/dialog.css (.wk-modal-* classes);
   .modal-head/.modal-body/.modal-x keep their existing primitive styles. */
import Icon from './Icon.astro';

export interface Props {
    id: string;
    title: string;
}

const { id, title } = Astro.props;
---

<div class="wk-modal-root" data-modal-root hidden>
    <div class="wk-modal-overlay" data-modal-overlay aria-hidden="true"></div>
    <div class="wk-modal" role="dialog" aria-modal="true" aria-labelledby={`${id}-title`} id={id} data-modal tabindex="-1">
        <div class="modal-head">
            <h2 id={`${id}-title`}>{title}</h2>
            <button type="button" class="modal-x" data-modal-close aria-label={`Close ${title}`}><Icon name="close" size="sm" /></button>
        </div>
        <div class="modal-body">
            <slot />
        </div>
    </div>
</div>

<script>
    function initModals() {
        const FOCUSABLE = 'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';
        const EXIT_MS = 180;

        function prefersReducedMotion() {
            return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        }

        function rootForPanel(panelId) {
            const panel = document.getElementById(panelId);
            if (!(panel instanceof HTMLElement)) return null;
            const root = panel.closest('[data-modal-root]');
            return root instanceof HTMLElement ? root : null;
        }

        /* Scroll lock is reference-counted in a shared attribute so nested or
           stacked modals restore scrolling only after the last one closes. */
        function lockScroll() {
            const count = Number(document.documentElement.getAttribute('data-wk-locks') ?? '0');
            document.documentElement.setAttribute('data-wk-locks', String(count + 1));
            document.documentElement.style.overflow = 'hidden';
        }

        function unlockScroll() {
            const count = Number(document.documentElement.getAttribute('data-wk-locks') ?? '0');
            if (count <= 1) {
                document.documentElement.removeAttribute('data-wk-locks');
                document.documentElement.style.overflow = '';
            } else {
                document.documentElement.setAttribute('data-wk-locks', String(count - 1));
            }
        }

        /* Virtual-cursor SR users can browse behind the Tab trap without
           background inert — hide main + footer while any modal holds focus. */
        function setBackgroundInert(on) {
            document.querySelectorAll('main, footer.site-footer').forEach((el) => {
                if (on) el.setAttribute('inert', '');
                else if (!document.documentElement.hasAttribute('data-wk-locks')) el.removeAttribute('inert');
            });
        }

        function focusPanel(root) {
            const panel = root.querySelector('[data-modal]');
            if (!(panel instanceof HTMLElement)) return;
            const autofocus = panel.querySelector('[data-modal-autofocus]');
            const target = autofocus instanceof HTMLElement ? autofocus : panel.querySelector(FOCUSABLE);
            if (target instanceof HTMLElement) target.focus({ preventScroll: true });
            else panel.focus({ preventScroll: true });
        }

        function openRoot(root, trigger) {
            if (root.getAttribute('data-modal-state') === 'open') return;
            root.setAttribute('data-modal-state', 'open');
            root.wkTrigger = trigger ?? document.activeElement ?? null;
            root.hidden = false;
            lockScroll();
            setBackgroundInert(true);
            if (prefersReducedMotion()) root.classList.add('open');
            else requestAnimationFrame(() => root.classList.add('open'));
            focusPanel(root);
        }

        function closeRoot(root) {
            if (root.getAttribute('data-modal-state') !== 'open') return;
            root.removeAttribute('data-modal-state');
            root.classList.remove('open');
            if (prefersReducedMotion()) root.hidden = true;
            else {
                window.setTimeout(() => {
                    if (root.getAttribute('data-modal-state') !== 'open') root.hidden = true;
                }, EXIT_MS);
            }
            unlockScroll();
            setBackgroundInert(false);
            const trigger = root.wkTrigger;
            root.wkTrigger = null;
            if (trigger instanceof HTMLElement && trigger.isConnected) trigger.focus({ preventScroll: true });
        }

        function trapTab(event, root) {
            const panel = root.querySelector('[data-modal]');
            if (!(panel instanceof HTMLElement)) return;
            const items = Array.from(panel.querySelectorAll(FOCUSABLE)).filter(
                (el) => el instanceof HTMLElement && !el.hidden && el.getClientRects().length > 0
            );
            if (items.length === 0) {
                event.preventDefault();
                panel.focus({ preventScroll: true });
                return;
            }
            const first = items[0];
            const last = items[items.length - 1];
            if (event.shiftKey && document.activeElement === first) {
                event.preventDefault();
                last.focus();
            } else if (!event.shiftKey && document.activeElement === last) {
                event.preventDefault();
                first.focus();
            }
        }

        /* Shared controller so components with their own dialog markup
           (e.g. CheckoutButton) open and close through one contract. */
        window.WhyKnotModal = {
            open: (panelId, trigger) => {
                const root = rootForPanel(panelId);
                if (root) openRoot(root, trigger ?? null);
            },
            close: (panelId) => {
                const root = rootForPanel(panelId);
                if (root) closeRoot(root);
            }
        };

        document.querySelectorAll('[data-modal-open]:not([data-wired])').forEach((trigger) => {
            trigger.setAttribute('data-wired', 'true');
            trigger.addEventListener('click', () => {
                const root = rootForPanel(trigger.getAttribute('data-modal-open') ?? '');
                if (root) openRoot(root, trigger);
            });
        });

        /* Document-wide on purpose: any component rendering the
           wk-modal-root contract (Modal, CheckoutButton) is picked up. */
        document.querySelectorAll('[data-modal-root]:not([data-wired])').forEach((root) => {
            root.setAttribute('data-wired', 'true');
            root.querySelector('[data-modal-overlay]')?.addEventListener('click', () => closeRoot(root));
            root.querySelectorAll('[data-modal-close], [data-dialog-cancel]').forEach((btn) => {
                btn.addEventListener('click', () => closeRoot(root));
            });
            root.addEventListener('keydown', (event) => {
                if (event.key === 'Escape') {
                    closeRoot(root);
                    return;
                }
                if (event.key === 'Tab') trapTab(event, root);
            });
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initModals);
    } else {
        initModals();
    }
    document.addEventListener('astro:page-load', initModals);
</script>
