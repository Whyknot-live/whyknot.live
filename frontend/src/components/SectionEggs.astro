---
/* SectionEggs — Lightweight Three.js ambient gravitational background easter egg.
   Mounts lazily on interaction or visibility. Respects prefers-reduced-motion.
   Renders a subtle, non-intrusive interactive particle lattice in the brand turquoise hue. */
interface Props {
    opacity?: number;
    particleCount?: number;
}

const { opacity = 0.35, particleCount = 48 } = Astro.props;
---

<div class="section-egg-canvas-root" data-section-egg data-particles={particleCount} style={`opacity: ${opacity};`}>
    <canvas class="section-egg-canvas" aria-hidden="true"></canvas>
</div>

<script>
    function initSectionEgg() {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        const roots = document.querySelectorAll('[data-section-egg]:not([data-egg-mounted])');
        roots.forEach((root) => {
            root.setAttribute('data-egg-mounted', 'true');
            const canvas = root.querySelector('canvas');
            if (!canvas) return;

            const observer = new IntersectionObserver(([entry]) => {
                if (entry.isIntersecting) {
                    observer.disconnect();
                    startThree(canvas, parseInt((root as HTMLElement).dataset.particles || '48', 10));
                }
            }, { threshold: 0.05 });

            observer.observe(root);
        });
    }

    async function startThree(canvas: HTMLCanvasElement, count: number) {
        try {
            const THREE = await import('three');

            const scene = new THREE.Scene();
            const camera = new THREE.PerspectiveCamera(60, canvas.clientWidth / (canvas.clientHeight || 1), 0.1, 1000);
            camera.position.z = 80;

            const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true, powerPreference: 'low-power' });
            renderer.setSize(canvas.clientWidth, canvas.clientHeight, false);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));

            // Particles geometry
            const geometry = new THREE.BufferGeometry();
            const positions = new Float32Array(count * 3);
            const originalPositions = new Float32Array(count * 3);

            for (let i = 0; i < count; i++) {
                const x = (Math.random() - 0.5) * 120;
                const y = (Math.random() - 0.5) * 80;
                const z = (Math.random() - 0.5) * 40;
                positions[i * 3] = x;
                positions[i * 3 + 1] = y;
                positions[i * 3 + 2] = z;
                originalPositions[i * 3] = x;
                originalPositions[i * 3 + 1] = y;
                originalPositions[i * 3 + 2] = z;
            }

            geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));

            // Turquoise / Teal particle material
            const material = new THREE.PointsMaterial({
                color: 0x20c5b5,
                size: 2.2,
                transparent: true,
                opacity: 0.65,
                blending: THREE.AdditiveBlending
            });

            const points = new THREE.Points(geometry, material);
            scene.add(points);

            // Connect nearest nodes with faint lines
            const lineMaterial = new THREE.LineBasicMaterial({
                color: 0x20c5b5,
                transparent: true,
                opacity: 0.12
            });

            let mouseX = 0;
            let mouseY = 0;
            let targetMouseX = 0;
            let targetMouseY = 0;

            const onMouseMove = (e: MouseEvent) => {
                const rect = canvas.getBoundingClientRect();
                targetMouseX = ((e.clientX - rect.left) / rect.width) * 2 - 1;
                targetMouseY = -(((e.clientY - rect.top) / rect.height) * 2 - 1);
            };

            window.addEventListener('mousemove', onMouseMove, { passive: true });

            let reqId: number;
            const animate = () => {
                mouseX += (targetMouseX - mouseX) * 0.05;
                mouseY += (targetMouseY - mouseY) * 0.05;

                points.rotation.y += 0.0008;
                points.rotation.x = mouseY * 0.15;
                points.rotation.z = mouseX * 0.15;

                renderer.render(scene, camera);
                reqId = requestAnimationFrame(animate);
            };

            animate();

            const onResize = () => {
                if (!canvas.parentElement) return;
                const w = canvas.parentElement.clientWidth;
                const h = canvas.parentElement.clientHeight || 200;
                camera.aspect = w / h;
                camera.updateProjectionMatrix();
                renderer.setSize(w, h, false);
            };

            window.addEventListener('resize', onResize, { passive: true });
        } catch {
            // WebGL not supported or dynamic import failed gracefully
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initSectionEgg);
    } else {
        initSectionEgg();
    }
    document.addEventListener('astro:page-load', initSectionEgg);
</script>
