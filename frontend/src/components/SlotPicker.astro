---
/* SlotPicker — calendar grid fed by GET /api/slots/availability.
   Props: inputName (radio group name), days (window size, max 60).
   Full days render disabled; the first available day is pre-checked.
   Uses getApiBaseUrl from shared resolver. */
interface Props {
    inputName?: string;
    days?: number;
}
const { inputName = 'slotDate', days = 14 } = Astro.props;
---

<div class="slot-picker" data-slot-picker data-days={days} data-input-name={inputName}>
    <p class="form-note" data-slot-status>Scanning launch queue availability…</p>
    <div class="slot-options-grid" data-slot-options role="radiogroup" aria-label="Available launch dates"></div>
</div>

<script>
    import { getApiBaseUrl } from '../lib/api-base';

    interface SlotItem {
        date: string;
        capacity: number;
        available: number;
    }

    function formatSlotDate(isoDate: string): string {
        try {
            const parts = isoDate.split('-');
            if (parts.length === 3) {
                const d = new Date(Number(parts[0]), Number(parts[1]) - 1, Number(parts[2]));
                return d.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
            }
        } catch {
            // fallback
        }
        return isoDate;
    }

    async function hydrateSlotPicker(root: Element) {
        const status = root.querySelector('[data-slot-status]');
        const options = root.querySelector('[data-slot-options]');
        const inputName = (root as HTMLElement).dataset.inputName || 'slotDate';
        const days = (root as HTMLElement).dataset.days || '14';

        if (!options) return;

        try {
            const apiBase = getApiBaseUrl();
            const res = await fetch(`${apiBase}/api/slots/availability?days=${encodeURIComponent(days)}`);
            if (!res.ok) throw new Error('availability failed');
            const slots: SlotItem[] = await res.json();
            if (!Array.isArray(slots) || slots.length === 0) throw new Error('no slots');

            options.textContent = '';
            let checkedFirst = false;
            const cards: HTMLButtonElement[] = [];

            const choose = (card: HTMLButtonElement, moveFocus: boolean) => {
                if (card.disabled) return;
                // Re-clicking the selected card is a no-op (no duplicate event).
                if (card.getAttribute('aria-checked') === 'true') {
                    if (moveFocus && document.activeElement !== card) card.focus();
                    return;
                }
                cards.forEach((other) => {
                    const on = other === card;
                    other.classList.toggle('is-selected', on);
                    other.setAttribute('aria-checked', String(on));
                    other.tabIndex = on ? 0 : -1;
                });
                (root as HTMLElement).dataset.value = card.value;
                options.dispatchEvent(
                    new CustomEvent('wk-radio-change', { bubbles: true, detail: { name: inputName, value: card.value } })
                );
                if (moveFocus) card.focus();
            };

            const enabledCards = () => cards.filter((card) => !card.disabled);

            const move = (current: HTMLButtonElement, delta: number) => {
                const enabled = enabledCards();
                if (enabled.length === 0) return;
                const at = enabled.indexOf(current);
                const base = at === -1 ? (delta > 0 ? -1 : 0) : at;
                choose(enabled[(base + delta + enabled.length) % enabled.length], true);
            };

            const jump = (which: string) => {
                const enabled = enabledCards();
                if (enabled.length === 0) return;
                choose(which === 'first' ? enabled[0] : enabled[enabled.length - 1], true);
            };

            slots.forEach((slot) => {
                const card = document.createElement('button');
                card.type = 'button';
                card.className = 'slot-option-card';
                card.setAttribute('role', 'radio');
                card.value = slot.date;
                card.tabIndex = -1;
                card.setAttribute('aria-checked', 'false');

                const isFull = slot.available <= 0;
                if (isFull) {
                    card.classList.add('is-disabled');
                    card.disabled = true;
                    card.setAttribute('aria-disabled', 'true');
                }

                if (!isFull && !checkedFirst) {
                    card.classList.add('is-selected');
                    card.setAttribute('aria-checked', 'true');
                    card.tabIndex = 0;
                    checkedFirst = true;
                    (root as HTMLElement).dataset.value = slot.date;
                }

                card.addEventListener('click', () => {
                    choose(card, false);
                });

                card.addEventListener('keydown', (event) => {
                    if (event.key === 'ArrowRight' || event.key === 'ArrowDown') {
                        event.preventDefault();
                        move(card, 1);
                    } else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') {
                        event.preventDefault();
                        move(card, -1);
                    } else if (event.key === 'Home') {
                        event.preventDefault();
                        jump('first');
                    } else if (event.key === 'End') {
                        event.preventDefault();
                        jump('last');
                    }
                });

                const dateSpan = document.createElement('span');
                dateSpan.className = 'slot-card-date';
                dateSpan.textContent = formatSlotDate(slot.date);

                const badge = document.createElement('span');
                badge.className = `slot-card-badge ${isFull ? 'is-full' : ''}`;
                badge.textContent = isFull ? 'Full' : `${slot.available} left`;

                card.appendChild(dateSpan);
                card.appendChild(badge);
                options.appendChild(card);
                cards.push(card);
            });

            if (status) {
                status.textContent = checkedFirst
                    ? 'Available launch dates: pick your deployment day.'
                    : 'Current queue is at capacity. Select skip-the-queue below.';
            }
        } catch (error) {
            console.error('Slot picker error:', error);
            if (status) {
                status.textContent = 'Queue schedule is temporarily offline. Please retry shortly.';
            }
        }
    }

    document.querySelectorAll('[data-slot-picker]').forEach((root) => {
        void hydrateSlotPicker(root);
    });
</script>
