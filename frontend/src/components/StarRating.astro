---
/* StarRating — read-only rating display. Text glyphs, never emoji. */
export interface Props {
    value: number;
    max?: number;
    label?: string;
}

const { value, max = 5, label } = Astro.props;
const clamped = Math.min(max, Math.max(0, Math.round(value)));
const text = label ?? `Rated ${clamped} out of ${max}`;
---

<span class="stars" role="img" aria-label={text}>
    {Array.from({ length: max }, (_, i) => (
        <svg class={i < clamped ? 'star-on' : 'star-off'} width="14" height="14" viewBox="0 0 24 24" fill={i < clamped ? 'currentColor' : 'none'} stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
        </svg>
    ))}
</span>
