---
/* TimeStamp — machine-readable <time> with human-readable rendering. */
export interface Props {
    date: Date | string;
}

const { date } = Astro.props;
const value = date instanceof Date ? date : new Date(date);
const readable = value.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<time datetime={value.toISOString()}>{readable}</time>
