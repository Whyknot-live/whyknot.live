---
// Waitlist component - Token-governed alpha signup with honeypot & shared API resolver
---

<section class="waitlist-section" id="waitlist" aria-labelledby="waitlist-title">
    <div class="floating-particles" aria-hidden="true">
        <div class="particle particle-1"></div>
        <div class="particle particle-2"></div>
        <div class="particle particle-3"></div>
        <div class="particle particle-4"></div>
        <div class="particle particle-5"></div>
        <div class="particle particle-6"></div>
    </div>

    <div class="waitlist-container">
        <div class="waitlist-content">
            <!-- Alpha Clearance Badge -->
            <div class="alpha-badge">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"/>
                    <path d="M12 7v5l3 3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
                <span>Alpha Access // Genesis Cohort</span>
            </div>

            <!-- Main Title (Nolan Register) -->
            <h2 class="waitlist-title" id="waitlist-title">
                Secure the <span class="gradient-text">Signal</span>
            </h2>

            <!-- Description -->
            <p class="waitlist-description">
                Gain priority clearance to autonomous technical audits, uncompromised discovery, and verified registry deployments before public rotation.
            </p>

            <!-- Waitlist Form -->
            <form class="waitlist-form" id="waitlist-form" role="form" aria-labelledby="waitlist-title">
                <!-- Honeypot -->
                <input
                    type="text"
                    name="b_knot_trap"
                    id="waitlist-trap"
                    tabindex="-1"
                    autocomplete="off"
                    aria-hidden="true"
                    style="position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; pointer-events: none;"
                />

                <div class="form-main">
                    <div class="form-group">
                        <label for="email-input" class="sr-only">Work email address</label>
                        <input 
                            type="email" 
                            placeholder="Enter your email address" 
                            class="form-input"
                            id="email-input"
                            name="email"
                            required
                            autocomplete="email"
                            aria-describedby="email-help"
                        />
                        <button type="submit" class="btn btn-primary" id="submit-btn" data-magnet="0.1">
                            <span class="btn-content">
                                <span class="btn-text">Request Access →</span>
                                <span class="btn-loader is-hidden" aria-hidden="true">
                                    <svg class="spinner" width="18" height="18" viewBox="0 0 24 24" fill="none">
                                        <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" opacity="0.25"/>
                                        <path d="M12 2a10 10 0 0 1 10 10" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
                                    </svg>
                                </span>
                            </span>
                        </button>
                    </div>

                    <p class="form-note" id="email-help">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="icon-inline" aria-hidden="true">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                        </svg>
                        Zero telemetry leaks. Uncompromising privacy protocol.
                    </p>
                </div>

                <!-- Interest Matrix -->
                <div class="form-interests" role="group" aria-labelledby="interests-label">
                    <h3 id="interests-label" class="interests-title">Priority Interests</h3>
                    <div class="interests-grid">
                        <button type="button" class="chip interest-chip" data-variant="choice" data-interest="screener" aria-pressed="false" data-selected="false">
                            Autonomous Screener
                        </button>
                        <button type="button" class="chip interest-chip" data-variant="choice" data-interest="discovery" aria-pressed="false" data-selected="false">
                            Curated Discovery
                        </button>
                        <button type="button" class="chip interest-chip" data-variant="choice" data-interest="launches" aria-pressed="false" data-selected="false">
                            Verified Launches
                        </button>
                        <button type="button" class="chip interest-chip" data-variant="choice" data-interest="api" aria-pressed="false" data-selected="false">
                            Developer API
                        </button>
                    </div>
                </div>

                <!-- Feedback states -->
                <div class="form-success" id="form-success" role="status" aria-live="polite">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="icon-inline" aria-hidden="true">
                        <path d="M20 6L9 17l-5-5"/>
                    </svg>
                    <span>Clearance recorded. Verification dispatched to your inbox.</span>
                </div>
                
                <div class="form-error" id="form-error" role="alert">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="icon-inline" aria-hidden="true">
                        <circle cx="12" cy="12" r="10"/>
                        <line x1="12" y1="8" x2="12" y2="12"/>
                        <line x1="12" y1="16" x2="12.01" y2="16"/>
                    </svg>
                    <span id="error-text">Submission failed. Please verify credentials.</span>
                </div>
            </form>
        </div>
    </div>
</section>

<script>
    import { getApiBaseUrl } from '../lib/api-base';

    const waitlistForm = document.getElementById('waitlist-form') as HTMLFormElement | null;
    const emailInput = document.getElementById('email-input') as HTMLInputElement | null;
    const trapInput = document.getElementById('waitlist-trap') as HTMLInputElement | null;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
    const btnText = submitBtn?.querySelector('.btn-text');
    const btnLoader = submitBtn?.querySelector('.btn-loader');
    const formSuccess = document.getElementById('form-success');
    const formError = document.getElementById('form-error');
    const errorText = document.getElementById('error-text');

    const selectedInterests = new Set<string>();
    const interestChips = document.querySelectorAll('.interest-chip');

    interestChips.forEach((chip) => {
        chip.addEventListener('click', () => {
            const interest = chip.getAttribute('data-interest');
            if (!interest) return;
            const isPressed = chip.getAttribute('aria-pressed') === 'true';
            if (isPressed) {
                chip.setAttribute('aria-pressed', 'false');
                chip.setAttribute('data-selected', 'false');
                selectedInterests.delete(interest);
            } else {
                chip.setAttribute('aria-pressed', 'true');
                chip.setAttribute('data-selected', 'true');
                selectedInterests.add(interest);
            }
        });
    });

    function isValidEmail(email: string): boolean {
        return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
    }

    function setLoading(loading: boolean) {
        if (!submitBtn) return;
        submitBtn.disabled = loading;
        btnText?.classList.toggle('is-hidden', loading);
        btnLoader?.classList.toggle('is-hidden', !loading);
    }

    function showSuccess(msg?: string) {
        if (formError) formError.classList.remove('show');
        if (formSuccess) {
            const label = formSuccess.querySelector('span');
            if (label && msg) label.textContent = msg;
            formSuccess.classList.add('show');
        }
    }

    function showError(msg: string) {
        if (formSuccess) formSuccess.classList.remove('show');
        if (errorText) errorText.textContent = msg;
        if (formError) formError.classList.add('show');
    }

    if (waitlistForm) {
        waitlistForm.addEventListener('submit', async (e) => {
            e.preventDefault();

            // Honeypot check
            if (trapInput && trapInput.value.trim().length > 0) {
                showSuccess('Clearance recorded. Verification dispatched to your inbox.');
                return;
            }

            const email = emailInput?.value.trim() ?? '';
            if (!isValidEmail(email)) {
                showError('Please supply a valid corporate or engineering address.');
                return;
            }

            setLoading(true);

            try {
                const apiBase = getApiBaseUrl();
                const res = await fetch(`${apiBase}/api/waitlist`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        email,
                        interests: Array.from(selectedInterests),
                        timestamp: new Date().toISOString(),
                        type: 'alpha-waitlist'
                    })
                });

                if (res.status === 409) {
                    showSuccess('Address already logged in registry. Priority position retained.');
                    if (emailInput) emailInput.value = '';
                    return;
                }

                if (!res.ok) {
                    const data = await res.json().catch(() => ({}));
                    showError((data as { error?: string })?.error || 'Registration rejected by host gateway.');
                    return;
                }

                showSuccess('Clearance recorded. Verification dispatched to your inbox.');
                if (emailInput) emailInput.value = '';
                interestChips.forEach((chip) => chip.setAttribute('aria-pressed', 'false'));
                selectedInterests.clear();
            } catch (err) {
                showError('Network disconnection. Re-verifying route.');
            } finally {
                setLoading(false);
            }
        });
    }
</script>
