 </div>
 </div>
 </div>
 </footer>
 )}

 	<!-- Cookie Consent Banner -->
	<CookieConsent />

	<!-- Global Toast Notifications -->
	<Toast />

 <!-- Scripts -->
 <script is:inline>
 // Theme system (system preference with logo toggle)
 function initThemeSystem() {
 // Get saved theme or default to system preference
 const savedTheme = localStorage.getItem('theme');
 const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
 
 // Determine initial theme with proper fallback logic
 let initialTheme;
 if (savedTheme && (savedTheme === 'light' || savedTheme === 'dark')) {
 initialTheme = savedTheme;
 } else {
 // If no saved theme or invalid saved theme, use system preference
 initialTheme = systemPrefersDark ? 'dark' : 'light';
 }
 
  // Apply theme + keep toggle buttons' pressed state honest
  function applyTheme(theme) {
  document.documentElement.setAttribute('data-theme', theme);
  const dark = theme === 'dark';
  document.querySelectorAll('[data-theme-toggle]').forEach((toggle) => {
  toggle.setAttribute('aria-pressed', String(dark));
  toggle.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme');
  });
  }
 
 // Set initial theme
 applyTheme(initialTheme);
 
 // Listen for system preference changes only if no manual theme is set
 window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
 const currentSavedTheme = localStorage.getItem('theme');
 if (!currentSavedTheme || (currentSavedTheme !== 'light' && currentSavedTheme !== 'dark')) {
 applyTheme(e.matches ? 'dark' : 'light');
 }
 });
 }

 // Smooth scroll for anchor links
 function initSmoothScroll() {
 document.querySelectorAll('a[href^="#"]').forEach(anchor => {
 anchor.addEventListener('click', function (e) {
 const href = (e.currentTarget && e.currentTarget.getAttribute && e.currentTarget.getAttribute('href')) || '';
 const target = document.querySelector(href);
 if (target) {
 e.preventDefault();
 target.scrollIntoView({
 behavior: 'smooth',
 block: 'start'
 });
 }
 });
 });
 }

 // External link handling
 function initExternalLinks() {
 document.querySelectorAll('a[href^="http"]').forEach(link => {
 if (!link.getAttribute('target')) {
 link.setAttribute('target', '_blank');
 link.setAttribute('rel', 'noopener noreferrer');
 }
 });
 }

 // Performance monitoring for Core Web Vitals (production-ready)
 function initPerformanceMonitoring() {
 // Only monitor performance when explicitly enabled via query param
 if ('performance' in window && window.location.search.includes('perf=1')) {
 // Web Vitals monitoring
 function getCLS() {
 return new Promise((resolve) => {
 new PerformanceObserver((list) => {
 const entries = list.getEntries();
 entries.forEach(entry => {
 if (!entry.hadRecentInput) {
 resolve(entry.value);
 }
 });
 }).observe({ entryTypes: ['layout-shift'] });
 });
 }
 
 function getFID() {
 return new Promise((resolve) => {
 new PerformanceObserver((list) => {
 const entries = list.getEntries();
 const firstEntry = entries[0];
 if (firstEntry) {
 resolve(firstEntry.processingStart - firstEntry.startTime);
 }
 }).observe({ entryTypes: ['first-input'] });
 });
 }
 
 function getLCP() {
 return new Promise((resolve) => {
 new PerformanceObserver((list) => {
 const entries = list.getEntries();
 const lastEntry = entries[entries.length - 1];
 if (lastEntry) {
 resolve(lastEntry.startTime);
 }
 }).observe({ entryTypes: ['largest-contentful-paint'] });
 });
 }

 window.addEventListener('load', async () => {
 const perfData = performance.getEntriesByType('navigation')[0];
 
 // Core Web Vitals
 const [cls, fid, lcp] = await Promise.allSettled([
 getCLS(),
 getFID(), 
 getLCP()
 ]);
 
 const performanceData = {
 // Traditional metrics
 domContentLoaded: perfData.domContentLoadedEventEnd - perfData.domContentLoadedEventStart,
 loadComplete: perfData.loadEventEnd - perfData.loadEventStart,
 firstByte: perfData.responseStart - perfData.requestStart,
 domInteractive: perfData.domInteractive - perfData.startTime,
 // Core Web Vitals
 cls: cls.status === 'fulfilled' ? cls.value : null,
 fid: fid.status === 'fulfilled' ? fid.value : null,
 lcp: lcp.status === 'fulfilled' ? lcp.value : null
 };
 
 // Log metrics when performance monitoring is enabled
 console.log('Performance Metrics:', performanceData);
 // Production: Send performanceData to your analytics service
 });
 }
 }

 // Cookie consent system
 function initCookieConsent() {
 const CONSENT_KEY = 'whyknot_cookie_consent';
 const banner = document.getElementById('cookie-consent-banner');
 
 if (!banner) return;
 
  const analyticsSwitch = document.getElementById('cookie-analytics');
  const preferencesSwitch = document.getElementById('cookie-preferences');
  const marketingSwitch = document.getElementById('cookie-marketing');
  const essentialSwitch = document.getElementById('cookie-essential');
  const acceptAllBtn = document.getElementById('cookie-accept-all');
  const rejectAllBtn = document.getElementById('cookie-reject-all');
  const saveBtn = document.getElementById('cookie-save');

  // Switch helpers (custom role="switch" buttons expose state via aria-checked)
  function isSwitchOn(el) {
  return el ? el.getAttribute('aria-checked') === 'true' : false;
  }

  function setSwitch(el, on) {
  if (el) el.setAttribute('aria-checked', on ? 'true' : 'false');
  }
 
 // Check existing consent
 function hasConsent() {
 try {
 const consent = localStorage.getItem(CONSENT_KEY);
 return consent !== null;
 } catch {
 return false;
 }
 }
 
 // Get saved consent state
 function getConsent() {
 try {
 const consent = localStorage.getItem(CONSENT_KEY);
 return consent ? JSON.parse(consent) : null;
 } catch {
 return null;
 }
 }
 
 // Save consent and dispatch event
 function saveConsent(consent) {
 try {
 consent.timestamp = Date.now();
 localStorage.setItem(CONSENT_KEY, JSON.stringify(consent));
 window.dispatchEvent(new CustomEvent('cookie-consent-update', { detail: consent }));
 } catch {
 // Ignore localStorage errors
 }
 }
 
  // Show/hide banner (modal-lite: focus in, trap Tab, restore on hide)
  let cookieReturnFocus = null;
  const COOKIE_FOCUSABLE = 'button:not([disabled])';

  function cookieFocusables() {
  return Array.from(banner.querySelectorAll(COOKIE_FOCUSABLE)).filter(
  (el) => el.getClientRects().length > 0
  );
  }

  function showBanner() {
  if (banner.getAttribute('aria-hidden') === 'false') return;
  cookieReturnFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
  banner.setAttribute('aria-hidden', 'false');
  banner.removeAttribute('inert');
  const first = cookieFocusables()[0];
  if (first) first.focus({ preventScroll: true });
  }

  function hideBanner(restoreFocus) {
  if (banner.getAttribute('aria-hidden') === 'true') return;
  banner.setAttribute('aria-hidden', 'true');
  banner.setAttribute('inert', '');
  if (restoreFocus !== false && cookieReturnFocus && cookieReturnFocus.isConnected) {
  cookieReturnFocus.focus({ preventScroll: true });
  }
  cookieReturnFocus = null;
  }

  banner.setAttribute('inert', '');
  banner.addEventListener('keydown', (event) => {
  if (banner.getAttribute('aria-hidden') === 'true') return;
  if (event.key === 'Escape') {
  event.preventDefault();
  saveConsent({
  essential: true,
  analytics: isSwitchOn(analyticsSwitch),
  preferences: isSwitchOn(preferencesSwitch),
  marketing: isSwitchOn(marketingSwitch)
  });
  hideBanner();
  return;
  }
  if (event.key !== 'Tab') return;
  const items = cookieFocusables();
  if (items.length === 0) {
  event.preventDefault();
  return;
  }
  const first = items[0];
  const last = items[items.length - 1];
  if (event.shiftKey && document.activeElement === first) {
  event.preventDefault();
  last.focus();
  } else if (!event.shiftKey && document.activeElement === last) {
  event.preventDefault();
  first.focus();
  }
  });
 
  // Load saved preferences into switches
  function loadPreferences() {
  const consent = getConsent();
  setSwitch(essentialSwitch, true);
  if (consent) {
  setSwitch(analyticsSwitch, consent.analytics || false);
  setSwitch(preferencesSwitch, consent.preferences || false);
  setSwitch(marketingSwitch, consent.marketing || false);
  }
  }

  // Accept all
  if (acceptAllBtn) {
  acceptAllBtn.addEventListener('click', () => {
  setSwitch(essentialSwitch, true);
  setSwitch(analyticsSwitch, true);
  setSwitch(preferencesSwitch, true);
  setSwitch(marketingSwitch, true);
  saveConsent({ essential: true, analytics: true, preferences: true, marketing: true });
  hideBanner();
  });
  }

  // Reject all (except essential)
  if (rejectAllBtn) {
  rejectAllBtn.addEventListener('click', () => {
  setSwitch(essentialSwitch, true);
  setSwitch(analyticsSwitch, false);
  setSwitch(preferencesSwitch, false);
  setSwitch(marketingSwitch, false);
  saveConsent({ essential: true, analytics: false, preferences: false, marketing: false });
  hideBanner();
  });
  }

  // Save preferences
  if (saveBtn) {
  saveBtn.addEventListener('click', () => {
  saveConsent({
  essential: true,
  analytics: isSwitchOn(analyticsSwitch),
  preferences: isSwitchOn(preferencesSwitch),
  marketing: isSwitchOn(marketingSwitch)
  });
  hideBanner();
  });
  }
 
 // Global function to open cookie settings
 window.openCookieSettings = function() {
 loadPreferences();
 showBanner();
 };
 
 // Initial check - show banner if no consent
 if (!hasConsent()) {
 // Small delay to allow page to render
 setTimeout(showBanner, 500);
 }
 }

  // Motion system: split headlines, reveal on scroll, count-up stats, card spotlight.
  // All decorative: content is fully visible without JS or under reduced motion.
  function initMotion() {
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Split-text headlines (plain-text elements only)
  document.querySelectorAll('[data-split]:not([data-split-done])').forEach((el) => {
  el.setAttribute('data-split-done', 'true');
  const text = el.textContent || '';
  el.setAttribute('aria-label', text.trim());
  el.textContent = '';
  Array.from(text).forEach((char, i) => {
  const span = document.createElement('span');
  span.className = 'ch';
  span.setAttribute('aria-hidden', 'true');
  span.style.setProperty('--i', String(i));
  span.textContent = char === ' ' ? '\u00A0' : char;
  el.appendChild(span);
  });
  });

  // Reveal on scroll
  const revealObserver = new IntersectionObserver((entries, observer) => {
  entries.forEach((entry) => {
  if (entry.isIntersecting) {
  entry.target.classList.add('is-visible');
  observer.unobserve(entry.target);
  }
  });
  }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
  document.querySelectorAll('[data-reveal]:not(.is-visible)').forEach((el) => {
  if (reduceMotion) el.classList.add('is-visible');
  else revealObserver.observe(el);
  });

  // Count-up stats
  const countObserver = new IntersectionObserver((entries, observer) => {
  entries.forEach((entry) => {
  if (!entry.isIntersecting) return;
  const el = entry.target;
  observer.unobserve(el);
  if (el.hasAttribute('data-count-done')) return;
  el.setAttribute('data-count-done', 'true');
  const target = parseFloat(el.getAttribute('data-count') || '0');
  const decimals = parseInt(el.getAttribute('data-decimals') || '0', 10);
  const suffix = el.getAttribute('data-suffix') || '';
  if (reduceMotion || !Number.isFinite(target)) {
  el.textContent = (Number.isFinite(target) ? target.toFixed(decimals) : '0') + suffix;
  return;
  }
  const duration = 1200;
  const started = performance.now();
  const tick = (now) => {
  const progress = Math.min(1, (now - started) / duration);
  const eased = 1 - Math.pow(1 - progress, 3);
  el.textContent = (target * eased).toFixed(decimals) + suffix;
  if (progress < 1) requestAnimationFrame(tick);
  };
  requestAnimationFrame(tick);
  });
  }, { threshold: 0.4 });
  document.querySelectorAll('[data-count]:not([data-count-done])').forEach((el) => countObserver.observe(el));

  // Cursor spotlight for cards (fine pointers only)
  if (window.matchMedia('(pointer: fine)').matches && !reduceMotion) {
  document.querySelectorAll('.spot-card:not([data-spot])').forEach((card) => {
  card.setAttribute('data-spot', 'true');
  card.addEventListener('pointermove', (event) => {
  const rect = card.getBoundingClientRect();
  card.style.setProperty('--mx', (event.clientX - rect.left) + 'px');
  card.style.setProperty('--my', (event.clientY - rect.top) + 'px');
  });
  });
  }
  }

  // Scroll FX: blur-in reveals, magnetic controls, scramble labels.
  function initScrollFX() {
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const finePointer = window.matchMedia('(pointer: fine)').matches;

  const blurObserver = new IntersectionObserver((entries, observer) => {
  entries.forEach((entry) => {
  if (entry.isIntersecting) {
  entry.target.classList.add('is-visible');
  observer.unobserve(entry.target);
  }
  });
  }, { threshold: 0.2 });
  document.querySelectorAll('[data-blur]:not(.is-visible)').forEach((el) => {
  if (reduceMotion) el.classList.add('is-visible');
  else blurObserver.observe(el);
  });

  if (finePointer && !reduceMotion) {
  document.querySelectorAll('[data-magnet]:not([data-magnet-done])').forEach((el) => {
  el.setAttribute('data-magnet-done', 'true');
  const strength = parseFloat(el.getAttribute('data-magnet') || '0.25');
  el.addEventListener('pointermove', (event) => {
  const rect = el.getBoundingClientRect();
  const x = event.clientX - rect.left - rect.width / 2;
  const y = event.clientY - rect.top - rect.height / 2;
  el.style.transform = `translate(${(x * strength).toFixed(1)}px, ${(y * strength).toFixed(1)}px)`;
  });
  el.addEventListener('pointerleave', () => {
  el.style.transform = '';
  });
  });
  }

  if (!reduceMotion) {
  const GLYPHS = '█▓▒░<>/\\|─01';
  document.querySelectorAll('[data-scramble]:not([data-scramble-done])').forEach((el) => {
  el.setAttribute('data-scramble-done', 'true');
  const original = el.textContent || '';
  let running = false;
  el.addEventListener('pointerenter', () => {
  if (running) return;
  running = true;
  const total = 14;
  let frame = 1;
  const tick = () => {
  if (frame > total) {
  el.textContent = original;
  running = false;
  return;
  }
  const settled = Math.floor((frame / total) * original.length);
  let out = original.slice(0, settled);
  for (let i = settled; i < original.length; i++) {
  out += original[i] === ' ' ? ' ' : GLYPHS[Math.floor(Math.random() * GLYPHS.length)];
  }
  el.textContent = out;
  frame += 1;
  window.setTimeout(tick, 28);
  };
  tick();
  });
  });
  }
  }

	// Knot easter eggs: console note + typing "knot" untangles every hidden thread.
	function initKnotEggs() {
		if (document.documentElement.hasAttribute('data-knot-eggs')) return;
		document.documentElement.setAttribute('data-knot-eggs', 'true');
		console.log(
			'%cWhyKnot // Scored · Verified · Untangled\nYou opened the developer console. Our kind of curious.\nTry typing "knot" anywhere on the page, then pull gently.\nTied together by the WhyKnot crew (humans, mostly untangled).',
			'font-size: 12px; color: #20c5b5; font-family: monospace;'
		);
		let buffer = '';
		document.addEventListener('keydown', (event) => {
			if (event.metaKey || event.ctrlKey || event.altKey) return;
			if (typeof event.key !== 'string' || event.key.length !== 1) return;
			const target = event.target;
			if (target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement || target instanceof HTMLSelectElement) return;
			buffer = (buffer + event.key.toLowerCase()).slice(-4);
			if (buffer === 'knot') {
				buffer = '';
				document.querySelectorAll('[data-knot-egg]').forEach((egg) => {
					if (egg instanceof HTMLElement) egg.hidden = false;
				});
				document.querySelectorAll('[data-knot]').forEach((knot) => {
					knot.setAttribute('data-untangled', 'true');
				});
				console.log('%cYou pulled the thread. Every hidden knot untangled.', 'color: #20c5b5; font-family: monospace;');
				if (window.WhyKnotToast && typeof window.WhyKnotToast.show === 'function') {
					window.WhyKnotToast.show('Knot untangled. You found a hidden thread.', 'success');
				}
			}
		});
	}

  // Initialize all systems
  function init() {
  initThemeSystem();
  initSmoothScroll();
  initExternalLinks();
  initPerformanceMonitoring();
  initCookieConsent();
  initMotion();
  initScrollFX();
  initKnotEggs();
  }

 // Run immediately if DOM is ready, otherwise wait for DOM load
 if (document.readyState === 'loading') {
 document.addEventListener('DOMContentLoaded', init);
 } else {
 init();
 }
 
  // Re-initialize theme system on Astro page transitions
