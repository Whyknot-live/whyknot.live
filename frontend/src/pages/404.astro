---
import Layout from "../layouts/Layout.astro";
import HeroKnot from "../components/HeroKnot.astro";
---

<Layout title="Signal Lost | WhyKnot" description="The coordinates do not resolve. Recalibrate to verified territory." constrainContent>
	<section class="section container">
		<div class="card not-found">
			<HeroKnot size="md" static tone="default" caption="http 404 · signal lost" punSeed="404" />
			<h1 class="error-title">Coordinates Unresolved</h1>
			<p class="card-tagline">
				The requested resource does not exist at this trajectory. It may have moved or decoupled.
			</p>
			<p class="hand-note">The coordinates do not resolve. Recalibrate ↓</p>
			<div class="cluster">
				<a class="btn" href="/">Home</a>
				<a class="btn btn-secondary" href="/discover">Discovery Library</a>
				<a class="btn btn-ghost" href="/search">Search Index</a>
			</div>
		</div>
	</section>
</Layout>
