 	<!-- Form Controls -->
	<section id="forms" class="component-section">
		<div class="section-container">
			<h2 class="section-title">Form Controls</h2>
			<p class="section-description">
				Precision inputs with hairline boundaries, tactile focus indicators, and deterministic validation states.
			</p>

			<div class="form-showcase">
				<div class="form-group">
					<label for="demo-text" class="form-label">Standard Text Field</label>
					<input type="text" id="demo-text" placeholder="e.g. Acme Systems" />
				</div>
				
				<div class="form-group">
					<label for="demo-search-ctrl" class="form-label">Search with Shortcut</label>
					<div class="scan-bar ds-fluid">
						<input type="search" id="demo-search-ctrl" placeholder="Search library..." />
						<kbd class="scan-kbd">⌘K</kbd>
					</div>
				</div>

				<div class="form-group">
					<label for="demo-email" class="form-label">Email Field</label>
					<input type="email" id="demo-email" placeholder="maker@example.com" autocomplete="email" />
				</div>
				
				<div class="form-group">
					<label for="demo-select-btn" class="form-label">Select Control</label>
					<Select
						id="demo-select"
						name="demo"
						label="Select Control"
						showLabel={false}
						options={[
							{ value: 'select-category', label: 'Select category...' },
							{ value: 'autonomous-agents', label: 'Autonomous Agents' },
							{ value: 'developer-tooling', label: 'Developer Tooling' },
							{ value: 'design-systems', label: 'Design Systems' },
						]}
					/>
				</div>
				
				<div class="form-group">
					<label for="demo-invalid" class="form-label">Invalid State</label>
