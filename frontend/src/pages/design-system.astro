 <div class="type-scale">
 {typeScale.map((step) => (
 <div class="type-scale-row">
 <code class="type-scale-token">{step.token}</code>
 <span class="type-scale-value">{step.value}</span>
 <span class="type-scale-sample type-step" data-step={step.size}>Discover the web's hidden gems</span>
 </div>
