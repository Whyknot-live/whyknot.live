---
import Layout from '../layouts/Layout.astro';
import ScoreRing from '../components/ScoreRing.astro';
import VerifyBadge from '../components/VerifyBadge.astro';
import SourceLine from '../components/SourceLine.astro';
import TechBadge from '../components/TechBadge.astro';
import BoostButton from '../components/BoostButton.astro';
import SiteCard from '../components/SiteCard.astro';
import LaunchCard from '../components/LaunchCard.astro';
import MakerCard from '../components/MakerCard.astro';
import CollectionCard from '../components/CollectionCard.astro';
import SectionHeader from '../components/SectionHeader.astro';
import EmptyState from '../components/EmptyState.astro';
import ErrorState from '../components/ErrorState.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Pagination from '../components/Pagination.astro';
import Avatar from '../components/Avatar.astro';
import SearchInput from '../components/SearchInput.astro';
import FormField from '../components/FormField.astro';
import StarRating from '../components/StarRating.astro';
import TimeStamp from '../components/TimeStamp.astro';
import Tabs from '../components/Tabs.astro';
import Modal from '../components/Modal.astro';
import Drawer from '../components/Drawer.astro';
import Toast from '../components/Toast.astro';
import Dropdown from '../components/Dropdown.astro';
import FilterDrawer from '../components/FilterDrawer.astro';
import Sparkline from '../components/Sparkline.astro';
import ScoreBars from '../components/ScoreBars.astro';
import ScoreCard from '../components/ScoreCard.astro';
import ScreenshotViewer from '../components/ScreenshotViewer.astro';
import HeroKnot from '../components/HeroKnot.astro';
import CommentThread from '../components/CommentThread.astro';
import CommentForm from '../components/CommentForm.astro';
import ReviewStars from '../components/ReviewStars.astro';
import ReviewCard from '../components/ReviewCard.astro';
import WatchButton from '../components/WatchButton.astro';
import AlertPrefs from '../components/AlertPrefs.astro';
import StatTile from '../components/StatTile.astro';
import DistributionBar from '../components/DistributionBar.astro';
import AlternativesGraph from '../components/AlternativesGraph.astro';
import Icon from '../components/Icon.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Select from '../components/Select.astro';
import { SplitReveal } from '../components/react/SplitReveal';
import { SpotlightCard } from '../components/react/SpotlightCard';
import { CountUp } from '../components/react/CountUp';
import { getCollection } from 'astro:content';

const title = "Design System - WhyKnot";
const description = "WhyKnot's comprehensive component library and design tokens";
const schema = {
 "@context": "https://schema.org",
 "@type": "WebPage",
 "name": "WhyKnot Design System",
 "description": description,
 "url": "https://www.whyknot.live/design-system"
};

// Type scale as defined in tokens.css (--text-*). Update both together.
const typeScale = [
 { size: 'xs', token: '--text-xs', value: '0.72rem' },
 { size: 'sm', token: '--text-sm', value: '0.82rem' },
 { size: 'ui', token: '--text-ui', value: '0.875rem' },
 { size: 'md', token: '--text-md', value: '0.95rem' },
 { size: 'base', token: '--text-base', value: '1rem' },
 { size: 'lg', token: '--text-lg', value: '1.08rem' },
 { size: 'lead', token: '--text-lead', value: '1.125rem' },
 { size: 'title-sm', token: '--text-title-sm', value: '1.25rem' },
 { size: 'xl', token: '--text-xl', value: '1.32rem' },
 { size: 'title', token: '--text-title', value: '1.5rem' },
 { size: '2xl', token: '--text-2xl', value: '1.7rem' },
 { size: 'title-lg', token: '--text-title-lg', value: '2rem' },
 { size: '3xl', token: '--text-3xl', value: '2.2rem' },
 { size: 'display-sm', token: '--text-display-sm', value: '2.5rem' },
 { size: '4xl', token: '--text-4xl', value: '2.9rem' },
 { size: 'section', token: '--text-section', value: 'clamp(1.6rem, 3vw, 2.2rem)' },
 { size: 'display', token: '--text-display', value: 'clamp(2.25rem, 6vw, 3.55rem)' },
];

// Living inventory: every product primitive rendered with real collection data
const showcaseSites = (await getCollection('sites'))
 .map((entry) => ({ slug: entry.id, ...entry.data }))
 .sort((a, b) => b.score - a.score);
const showcaseLaunches = (await getCollection('launches'))
 .map((entry) => ({ slug: entry.id, ...entry.data }))
 .sort((a, b) => a.rank - b.rank);
const showcaseCollections = (await getCollection('collections'))
 .map((entry) => ({ slug: entry.id, ...entry.data }));
--- 

<Layout
 title={title}
 description={description}
 keywords="design system, UI components, turquoise theme, web design, component library, tokens"
 schema={schema}
>
 <article class="design-system-page">
 <!-- Header Section -->
 <section class="design-system-header has-gradient-bg">
 <div class="section-container">
 <div class="header-content hero-card gradient-surface">
 <h1 class="page-title gradient-text">Design System</h1>
 <p class="page-subtitle">
 WhyKnot's comprehensive component library and design tokens
 </p>
 <p class="page-description">
 Explore our turquoise + blue hybrid design system built for innovation 
 and accessibility. Every component sits on a solid surface with a hairline border
 and semantic color roles.
 </p>
 </div>
 </div>
 </section>

 <!-- Table of Contents -->
 <section class="toc-section">
 <div class="section-container">
 <nav class="design-toc elevated" aria-labelledby="toc-heading">
 <h2 id="toc-heading" class="toc-title">Components</h2>
 <div class="toc-grid">
 <a href="#colors" class="toc-item">Colors & Tokens</a>
 <a href="#typography" class="toc-item">Typography</a>
  <a href="#buttons" class="toc-item">Buttons</a>
  <a href="#icons" class="toc-item">Icons</a>
  <a href="#forms" class="toc-item">Form Elements</a>
 <a href="#cards" class="toc-item">Cards</a>
