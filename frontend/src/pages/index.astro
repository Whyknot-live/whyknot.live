---
/* / — product gateway: split hero with a living knot,
   community launches, snap rails, bento collections. */
import Layout from "../layouts/Layout.astro";
import Waitlist from "../components/Waitlist.astro";
import SectionHeader from "../components/SectionHeader.astro";
import SiteCard from "../components/SiteCard.astro";
import LaunchCard from "../components/LaunchCard.astro";
import CollectionCard from "../components/CollectionCard.astro";
import ScoreRing from "../components/ScoreRing.astro";
import VerifyBadge from "../components/VerifyBadge.astro";
import SourceLine from "../components/SourceLine.astro";
import HeroConstellation from "../components/HeroConstellation.astro";
import Icon from "../components/Icon.astro";
import SectionEggs from "../components/SectionEggs.astro";
import { SpotlightCard } from "../components/react/SpotlightCard";
import { CountUp } from "../components/react/CountUp";
import { getFlatSites, getFlatCollections, getFlatTopics, getFlatLaunches, facetTerms, stackTerms, liveOnly, rankedRecent } from "../lib/content";

const title = "WhyKnot | Discover websites worth a click";
const description =
    "WhyKnot is a hand-picked library of exceptional websites. Scored on real performance, verified by actual humans, free of AI slop.";

const schema = {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "WhyKnot",
    description: description,
    url: "https://www.whyknot.live",
    potentialAction: {
        "@type": "SearchAction",
        target: "https://www.whyknot.live/search?q={query}",
        "query-input": "required name=query",
    },
};

const sites = await getFlatSites();
const collections = await getFlatCollections();
const topics = await getFlatTopics();
// Top-3 rail: best-ranked of the last 7 days; a quiet week falls back to plain
// rank so the rail never empties (owner decision 2026-10-08). Scheduled
// entries live on /launches/upcoming.
const launches = liveOnly(await getFlatLaunches());
const recent = rankedRecent(launches, 7);
const weekLaunches = recent.length > 0 ? recent.slice(0, 3) : launches.slice(0, 3);
const picks = sites.filter((site) => site.score >= 90);
const [feature, ...pickRest] = picks;
const rail = sites.slice(0, 6);
const ticker = stackTerms(sites).slice(0, 14);
const avg = sites.length > 0 ? sites.reduce((sum, site) => sum + site.score, 0) / sites.length : 0;
const categoryCount = facetTerms(sites, "category").length;
const featureMono = feature ? feature.name.trim().charAt(0).toUpperCase() : "W";
---

<Layout title={title} description={description} schema={schema} transparentNav={true}>
    <!-- Hero: live map of the library behind, type + handmade props in front -->
    <section class="hero-cover-section" aria-labelledby="gateway-title">
        <HeroConstellation sites={sites} />
        <div class="hero-cover-scrim" aria-hidden="true"></div>
        <p class="hand-note tape-note hero-tape" data-reveal="fade">no paid rankings. knot now, knot ever ↓</p>
        <div class="container hero-cover-content">
            <p class="eyebrow-mono" data-reveal="fade">Curated library · Scored · Verified</p>
            <h1 id="gateway-title" class="gateway-title" data-reveal="fade">
                Discover websites <em>worth a <span class="gradient-text">click.</span></em>
            </h1>
            <p class="gateway-sub" data-reveal data-blur style="--reveal-delay: 120ms">
                A hand-picked library of exceptional websites. Scored on real performance,
                verified by actual humans, and untangled from the noise.
            </p>
            <form class="scan-bar" action="/search" method="get" role="search" data-reveal style="--reveal-delay: 220ms">
                <svg class="scan-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <label class="sr-only" for="gateway-search">Search the library</label>
                <input id="gateway-search" type="search" name="q" placeholder="Try “portfolio”, “minimal”, “Astro”…" autocomplete="off" required />
                <kbd class="scan-kbd" aria-hidden="true">/</kbd>
                <button type="submit" class="btn" data-magnet="0.12">Search</button>
            </form>
            <div class="hero-quick-chips" data-reveal style="--reveal-delay: 280ms">
                <span class="quick-chips-label">Quick explore:</span>
                <div class="quick-chips-list">
                    {topics.slice(0, 5).map((topic) => (
                        <a class="chip" href={`/topics/${topic.slug}`}>{topic.name}</a>
                    ))}
                    <a class="chip chip-all" href="/discover">All topics <Icon name="arrow-right" size="sm" /></a>
                </div>
            </div>
        </div>
    </section>

    <!-- Proof strip: confident metrics, hairline grid -->
    <div class="container prism-proof-container">
        <div class="prism-proof" aria-label="Library coverage">
            <div class="prism-proof-inner" data-reveal>
                <div class="proof-cell">
                    <span class="proof-tag">01 // ARCHIVE</span>
                    <span class="proof-num">{sites.length}</span>
                    <span class="proof-label">sites curated</span>
                </div>
                <div class="proof-cell">
                    <span class="proof-tag">02 // BASELINE</span>
                    <span class="proof-num">{avg.toFixed(1)}</span>
                    <span class="proof-label">avg WhyKnot score</span>
                </div>
                <div class="proof-cell">
                    <span class="proof-tag">03 // TAXONOMY</span>
                    <span class="proof-num">{categoryCount}</span>
                    <span class="proof-label">categories</span>
                </div>
                <div class="proof-cell">
                    <span class="proof-tag">04 // THREADS</span>
                    <span class="proof-num">{collections.length}</span>
                    <span class="proof-label">curated collections</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Featured: one story + shortlist -->
    {feature && (
        <section aria-labelledby="gateway-featured">
            <div class="container section">
                <div data-reveal data-view-rise>
                    <SectionHeader
                        index="01"
                        knot
                        eyebrow="Curated"
                        title="The top shelf"
                        aside="Picked by editors who still remember when the web was fun."
                        href="/editors-picks"
                        linkLabel="All picks"
                    />
                </div>
                <div class="feature-grid">
                    <article class="card spot-card feature-card" data-reveal>
                        <a class="site-card-link" href={`/sites/${feature.slug}`} aria-label={`${feature.name}: ${feature.tagline}`}>
                            <div class="site-shot" data-accent={feature.accent} role="img" aria-label={`Preview placeholder for ${feature.name}`}>
                                <span class="shot-mono" aria-hidden="true">{featureMono}</span>
                            </div>
                            <div class="card-meta-row">
                                <span class="badge badge-pick">Editor's Pick</span>
                                <VerifyBadge state={feature.verified ? 'verified' : 'unverified'} />
                            </div>
                            <h3>{feature.name}</h3>
                            <p class="card-tagline">{feature.tagline}</p>
                            <div class="feature-rings">
                                <ScoreRing score={feature.score} label="Overall" size="sm" />
                                <ScoreRing score={feature.performance} label="Perf" size="sm" />
                            </div>
                        </a>
                    </article>
                    <div class="leaderboard" data-reveal style="--reveal-delay: 120ms">
                        {pickRest.slice(0, 3).map((site) => (
                            <a class="leaderboard-row" href={`/sites/${site.slug}`}>
                                <ScoreRing score={site.score} size="sm" />
                                <span class="leaderboard-main"><strong>{site.name}</strong><span>{site.tagline}</span></span>
                            </a>
                        ))}
                        <a class="leaderboard-row" href="/editors-picks">
                            <span class="leaderboard-main"><strong>All editor's picks <Icon name="arrow-right" size="sm" /></strong><span>Every 90+ site in one place</span></span>
                        </a>
                    </div>
                </div>
            </div>
        </section>
    )}

    <!-- Trending rail -->
    <section aria-labelledby="gateway-trending">
        <div class="container section">
            <div data-reveal data-view-rise>
                <SectionHeader
                    index="02"
                    knot
                    eyebrow="Feed"
                    title="Trending right now"
                    aside="No sponsored boost buttons. Your VC check can't buy taste."
                    href="/trending"
                    linkLabel="Full ranking"
                />
            </div>
            <div class="rail" data-reveal style="--reveal-delay: 100ms">
                {rail.map((site) => <SiteCard site={site} />)}
                <a class="rail-end" href="/trending">Full ranking <Icon name="arrow-right" size="sm" /></a>
            </div>
        </div>
    </section>

    <!-- Stack ticker: live technical fingerprint telemetry -->
    <div class="marquee" aria-label="Technologies detected across the library">
        <div class="marquee-track">
            {ticker.map((term) => <span class="tech-badge">{term.value}</span>)}
            {ticker.map((term) => <span class="tech-badge" aria-hidden="true">{term.value}</span>)}
        </div>
    </div>

    <!-- Launches of the week: Community-voted launches from independent makers -->
    <section aria-labelledby="gateway-launches" id="launches">
        <div class="container section">
            <div data-reveal data-view-rise>
                <SectionHeader
                    index="03"
                    knot
                    eyebrow="Launches"
                    title="Craft over hype"
                    aside="Community-backed launches from independent makers. No paywalled upvote cartels."
                    href="/launches"
                    linkLabel="All launches"
                />
            </div>
            <div class="card-grid" data-cols="3" data-reveal style="--reveal-delay: 100ms">
                {weekLaunches.map((launch) => (
                    <LaunchCard launch={launch} />
                ))}
            </div>
            <div class="cluster" style="justify-content: center; margin-top: var(--space-6)">
                <a class="btn btn-primary" href="/launches" data-magnet="0.12">Explore All Launches <Icon name="arrow-right" size="sm" /></a>
                <a class="btn btn-secondary" href="/submit" data-magnet="0.12">Submit Your Launch</a>
            </div>
        </div>
    </section>

    <!-- Collections bento -->
    <section aria-labelledby="gateway-collections">
        <div class="container section">
            <div data-reveal data-view-rise>
                <SectionHeader
                    index="04"
                    knot
                    eyebrow="Curated"
                    title="Collections with an opinion"
                    aside="Organized threads. Because algorithms have terrible taste."
                    href="/collections"
                    linkLabel="All collections"
                />
            </div>
            <div class="card-grid" data-cols="3" data-reveal style="--reveal-delay: 100ms">
                {collections.slice(0, 3).map((collection, i) => (
                    <div class={i === 0 ? 'span-2' : undefined}>
                        <CollectionCard
                            slug={collection.slug}
                            name={collection.name}
                            description={collection.description}
                            count={collection.siteSlugs.length || collection.count}
                        />
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- Trust -->
    <section aria-labelledby="gateway-trust">
        <div class="container section">
            <div data-reveal data-view-rise>
                <SectionHeader
                    index="05"
                    knot
                    eyebrow="Honest Rules"
                    title="Trust you don't have to take on faith"
                    aside="Zero pay-to-win. We don't sell scores, and we cite our receipts."
                    href="/legal/methodology"
                    linkLabel="Methodology"
                />
            </div>
            <div class="card-grid" data-cols="3" data-reveal style="--reveal-delay: 100ms">
                <div class="card spot-card">
                    <VerifyBadge state="verified" date="2026-09-01" />
                    <h3>DNS-verified ownership</h3>
                    <p class="card-tagline">We confirm makers control the domain via DNS. (We don't audit their taxes—just proof of control).</p>
                </div>
                <div class="card spot-card">
                    <h3>Every fact cited</h3>
                    <div class="cluster">
                        <SourceLine source="detected" timestamp="2026-09-09" confidence="high" />
                        <SourceLine source="owner" timestamp="2026-09-02" confidence="high" />
                        <SourceLine source="editor" timestamp="2026-09-01" />
                    </div>
                    <p class="card-tagline">Bot detections, owner claims, and editorial notes are labeled separately. If a bot found it, we say so.</p>
                </div>
                <div class="card spot-card">
                    <h3>Zero pay-to-win</h3>
                    <ScoreRing score={94} label="Example" size="sm" />
                    <p class="card-tagline">Sponsored slots are labeled with neon clarity. Paying gets an ad slot; it buys 0 points on a score.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Maker entry -->
    <section aria-labelledby="gateway-maker">
        <div class="container section">
            <div class="card spot-card" data-tone="accent" data-reveal data-view-rise>
                <SectionHeader
                    index="06"
                    knot
                    eyebrow="Makers"
                    title="Built something with actual craft?"
                    aside="Tired of paywalled upvote cartels? Launch clean."
                />
                <div class="cluster">
                    <a class="btn btn-primary" href="/submit" data-magnet="0.12">Submit a Launch <Icon name="arrow-right" size="sm" /></a>
                    <a class="btn btn-ghost" href="/discover">See the bar</a>
                </div>
            </div>
        </div>
    </section>

    <Waitlist />
</Layout>

<script>
    /* Press "/" anywhere to jump to the library search. */
    function initSearchShortcut() {
        if (document.documentElement.hasAttribute("data-search-shortcut")) return;
        document.documentElement.setAttribute("data-search-shortcut", "true");
        document.addEventListener("keydown", (event) => {
            if (event.key !== "/" || event.metaKey || event.ctrlKey || event.altKey) return;
            const target = event.target;
            if (target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement || target instanceof HTMLSelectElement) return;
            const field = document.querySelector("#gateway-search");
            if (field instanceof HTMLInputElement) {
                event.preventDefault();
                field.focus();
            }
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initSearchShortcut);
    } else {
        initSearchShortcut();
    }
    document.addEventListener('astro:page-load', initSearchShortcut);
</script>
