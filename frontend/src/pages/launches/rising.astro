---
/* /launches/rising — momentum board: backing velocity across all launches. */
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import LaunchCard from '../../components/LaunchCard.astro';
import { getFlatLaunches, launchVelocity } from '../../lib/content';

const title = 'Rising launches | WhyKnot';
const description = 'Launches gaining the fastest community backing, ranked by velocity.';

const launches = await getFlatLaunches();
const now = launches.reduce((max, launch) => Math.max(max, launch.publishedAt.valueOf()), 0);
const board = [...launches].sort((a, b) => launchVelocity(b, now) - launchVelocity(a, now));
---

<Layout title={title} description={description} constrainContent>
    <div class="container section">
        <Breadcrumbs trail={[{ label: 'Launches', href: '/launches' }, { label: 'Rising' }]} />
        <SectionHeader eyebrow="Launch board" title="Rising" description={description} />
        <div class="tabs" role="navigation" aria-label="Launch boards">
            <a class="tab" href="/launches">Today</a>
            <a class="tab" href="/launches/week">This week</a>
            <a class="tab" href="/launches/month">Month</a>
            <a class="tab" href="/launches/rising" aria-current="page">Rising</a>
            <a class="tab" href="/launches/upcoming">Upcoming</a>
            <a class="tab" href="/launches/winners">Winners</a>
        </div>
        <div class="card-grid" data-cols="2" style="margin-top: var(--space-5)">
            {board.map((launch) => <LaunchCard launch={launch} />)}
        </div>
        <p class="method-note" style="margin-top: var(--space-8)">
            Velocity means backings plus triple-weighted discussion, divided by days live.
            Steady backing across the day outranks a single spike. <a href="/legal/methodology">How ranking works</a>
        </p>
    </div>
</Layout>
