---
import Layout from '../../layouts/Layout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import Icon from '../../components/Icon.astro';

const title = 'WhyKnot Screener | Transparent Website Technical Audits';
const description = 'Analyze any public website in seconds. Real scores for performance, accessibility, security headers, SEO, and tech stack, with receipts attached.';

const sampleSites = [
    { label: 'Astro', url: 'https://astro.build' },
    { label: 'Linear', url: 'https://linear.app' },
    { label: 'Resend', url: 'https://resend.com' },
    { label: 'Raycast', url: 'https://raycast.com' },
];

const pillars = [
    {
        icon: 'zap' as const,
        name: 'Performance',
        desc: 'Measures time to first byte, document weight, and asset density to gauge real-world rendering speed.'
    },
    {
        icon: 'eye' as const,
        name: 'Accessibility',
        desc: 'Verifies language declaration, responsive viewport, image alt text coverage, and heading structure.'
    },
    {
        icon: 'shield' as const,
        name: 'Security Headers',
        desc: 'Audits HSTS, Content-Security-Policy, X-Frame-Options, X-Content-Type-Options, and HTTPS enforcement.'
    },
    {
        icon: 'search' as const,
        name: 'SEO',
        desc: 'Inspects titles, meta descriptions, Open Graph banners, canonical URLs, and structured data.'
    },
    {
        icon: 'layers' as const,
        name: 'Tech Fingerprint',
        desc: 'Detects frameworks, CMS platforms, CDNs, hosting, and analytics scripts behind the page.'
    },
    {
        icon: 'check' as const,
        name: 'Actionable Findings',
        desc: 'Returns prioritized recommendations with the evidence behind each score, never a bare number.'
    },
];
---

<Layout title={title} description={description}>
    <div class="screener-wrap">
        <section class="screener-hero" aria-labelledby="screener-title">
            <div class="screener-badge">
                <span class="pulse-dot" aria-hidden="true"></span>
                WhyKnot Screener
            </div>
            <h1 id="screener-title" class="screener-hero-title">
                Inspect Any Website.<br />
                <span class="gradient-text">Receipts over claims.</span>
            </h1>
            <p class="screener-hero-desc">
                Paste any public link. We fetch the page and score performance, accessibility, security,
                SEO, and tech stack, then show the evidence behind every number.
            </p>

            <form class="screener-form" action="/screener/scan" method="GET">
                <div class="screener-input-wrap">
                    <span class="screener-prefix" aria-hidden="true">https://</span>
                    <input
                        type="text"
                        name="url"
                        id="screener-url-input"
                        class="screener-input"
                        placeholder="example.com"
                        required
                        autocomplete="off"
                        autocapitalize="none"
                        spellcheck="false"
                        aria-label="Website address to scan"
                    />
                    <button type="submit" class="screener-btn" id="screener-submit-btn">
                        Analyze
                    </button>
                </div>

                <div class="screener-quick-chips">
                    <span>Try an example:</span>
                    {sampleSites.map((s) => (
                        <a href={`/screener/scan?url=${encodeURIComponent(s.url)}`} class="screener-chip">
                            {s.label}
                        </a>
                    ))}
                </div>
            </form>
        </section>

        <section class="screener-pillars-section" aria-labelledby="pillars-heading">
            <SectionHeader
                eyebrow="Capabilities"
                title="What the Screener Analyzes"
                aside="Every score shows its source."
            />

            <div class="screener-pillars-grid">
                {pillars.map((p) => (
                    <div class="screener-pillar-card">
                        <div class="screener-pillar-icon" aria-hidden="true">
                            <Icon name={p.icon} size="lg" />
                        </div>
                        <h3 class="screener-pillar-title">{p.name}</h3>
                        <p class="screener-pillar-desc">{p.desc}</p>
                    </div>
                ))}
            </div>
        </section>

        <section class="screener-how-section" aria-labelledby="how-heading">
            <SectionHeader
                eyebrow="How it works"
                title="Three steps, no signup"
                index="01"
            />
            <ol class="screener-steps">
                <li class="screener-step">
                    <span class="screener-step-num">01</span>
                    <div>
                        <h3 class="screener-step-name">Paste a link</h3>
                        <p class="screener-step-desc">Any public website. We reach it over HTTPS and read the page, nothing more.</p>
                    </div>
                </li>
                <li class="screener-step">
                    <span class="screener-step-num">02</span>
                    <div>
                        <h3 class="screener-step-name">We measure</h3>
                        <p class="screener-step-desc">Response time, headers, markup, and assets are pulled directly from the live page.</p>
                    </div>
                </li>
                <li class="screener-step">
                    <span class="screener-step-num">03</span>
                    <div>
                        <h3 class="screener-step-name">Read the report</h3>
                        <p class="screener-step-desc">Each score breaks down into the checks that produced it, with fixes you can act on.</p>
                    </div>
                </li>
            </ol>
        </section>

        <div class="screener-cta-banner">
            <div>
                <h2 class="screener-cta-title">Built something worth a look?</h2>
                <p class="screener-cta-desc">
                    Claim your website profile on WhyKnot to get verified ownership and a place in our curated catalog.
                </p>
            </div>
            <div class="screener-cta-actions">
                <a href="/verify" class="btn btn-secondary">About Verification</a>
                <a href="/submit" class="btn btn-primary">Submit a launch</a>
            </div>
        </div>
    </div>
</Layout>
