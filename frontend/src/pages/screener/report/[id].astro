---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';

const title = 'Audit Report | WhyKnot Screener';
const description = 'A transparent technical audit with the evidence behind every score.';

// Static-only (owner: "keep it static or ssg but not ssr"). Report ids are
// minted live at scan time and never known at build, so this route ships a
// single prerendered shell; the real audit is fetched by id client-side and
// unknown or expired ids show the empty state. getStaticPaths yields the one
// literal path so the build has something to prerender.
export async function getStaticPaths() {
    return [{ params: { id: 'index' } }];
}
---

<Layout title={title} description={description}>
    <div class="screener-wrap">
        <Breadcrumbs trail={[{ label: 'Home', href: '/' }, { label: 'Screener', href: '/screener' }, { label: 'Report' }]} />

        <section class="report-shell" id="report-root" aria-labelledby="report-title">
            <div class="report-loading" id="report-loading">
                <span class="pulse-dot" aria-hidden="true"></span>
                <p>Loading the audit report.</p>
            </div>

            <div class="report-empty" id="report-empty" hidden>
                <h1 id="report-title" class="report-empty-title">This report has expired</h1>
                <p class="report-empty-desc">
                    Reports are kept for a short window after a scan. Run the audit again to see fresh results.
                </p>
                <a href="/screener" class="btn btn-primary">Run a new scan</a>
            </div>

            <div class="report-body" id="report-body" hidden>
                <header class="report-header">
                    <div class="report-header-main">
                        <span class="screener-badge">WhyKnot Screener</span>
                        <h1 id="report-title" class="report-title">
                            <span id="report-domain"></span>
                        </h1>
                        <p class="report-url" id="report-url"></p>
                    </div>
                    <div class="report-score-ring">
                        <svg viewBox="0 0 120 120" class="score-ring" aria-hidden="true">
                            <circle cx="60" cy="60" r="52" class="score-ring-track" />
                            <circle cx="60" cy="60" r="52" class="score-ring-fill" id="score-ring-fill" />
                        </svg>
                        <div class="score-ring-value">
                            <span class="score-ring-num" id="report-overall"></span>
                            <span class="score-ring-label">Overall</span>
                        </div>
                    </div>
                </header>

                <section class="report-scores" aria-labelledby="report-scores-heading">
                    <h2 id="report-scores-heading" class="report-section-title">Scores</h2>
                    <div class="report-bars" id="report-bars"></div>
                </section>

                <section class="report-meta-grid" aria-labelledby="report-meta-heading">
                    <h2 id="report-meta-heading" class="report-section-title">Measurements</h2>
                    <dl class="report-meta" id="report-meta"></dl>
                </section>

                <section class="report-security" aria-labelledby="report-security-heading">
                    <h2 id="report-security-heading" class="report-section-title">Security Headers</h2>
                    <ul class="report-headers" id="report-headers"></ul>
                </section>

                <section class="report-tech" aria-labelledby="report-tech-heading">
                    <h2 id="report-tech-heading" class="report-section-title">Detected Stack</h2>
                    <div class="report-tech-list" id="report-tech"></div>
                </section>

                <section class="report-findings" aria-labelledby="report-findings-heading">
                    <h2 id="report-findings-heading" class="report-section-title">Findings</h2>
                    <ul class="report-findings-list" id="report-findings"></ul>
                </section>

                <div class="report-cta">
                    <a href="/screener" class="btn btn-secondary">Scan another site</a>
                    <a href="/submit" class="btn btn-primary">Submit a launch</a>
                </div>
            </div>
        </section>
    </div>
</Layout>

<script>
    import { getApiBaseUrl } from '../../../lib/api-base';

    const scanId = window.location.pathname.split('/').filter(Boolean).pop() ?? '';

    const loadingEl = document.getElementById('report-loading');
    const emptyEl = document.getElementById('report-empty');
    const bodyEl = document.getElementById('report-body');

    const domainEl = document.getElementById('report-domain');
    const urlEl = document.getElementById('report-url');
    const overallEl = document.getElementById('report-overall');
    const ringFill = document.getElementById('score-ring-fill') as SVGCircleElement | null;
    const barsEl = document.getElementById('report-bars');
    const metaEl = document.getElementById('report-meta');
    const headersEl = document.getElementById('report-headers');
    const techEl = document.getElementById('report-tech');
    const findingsEl = document.getElementById('report-findings');

    type Audit = {
        scanId: string;
        url: string;
        domain: string;
        timestamp: string;
        durationMs: number;
        scores: { overall: number; performance: number; accessibility: number; bestPractices: number; seo: number };
        metrics: { ttfbMs: number; contentLengthBytes: number; domNodesEstimated: number; scriptsCount: number; stylesheetsCount: number; imagesCount: number; imagesMissingAltCount: number; linksCount: number };
        security: { isHttps: boolean; score: number; headers: Array<{ name: string; present: boolean; value: string | null; status: 'pass' | 'warning' | 'fail'; description: string }> };
        techStack: Array<{ name: string; category: string; confidence: number }>;
        findings: Array<{ id: string; category: string; severity: 'high' | 'medium' | 'low' | 'pass'; title: string; description: string; recommendation?: string }>;
    };

    function el(tag: string, className?: string, text?: string): HTMLElement {
        const node = document.createElement(tag);
        if (className) node.className = className;
        if (text != null) node.textContent = text;
        return node;
    }

    function fmtBytes(n: number): string {
        if (n < 1024) return n + ' B';
        if (n < 1024 * 1024) return (n / 1024).toFixed(1) + ' KB';
        return (n / (1024 * 1024)).toFixed(2) + ' MB';
    }

    function showEmpty() {
        if (loadingEl) loadingEl.hidden = true;
        if (bodyEl) bodyEl.hidden = true;
        if (emptyEl) emptyEl.hidden = false;
    }

    function render(audit: Audit) {
        if (!loadingEl || !bodyEl) return;
        loadingEl.hidden = true;
        bodyEl.hidden = false;

        if (domainEl) domainEl.textContent = audit.domain;
        if (urlEl) urlEl.textContent = audit.url;
        if (overallEl) overallEl.textContent = String(audit.scores.overall);

        if (ringFill) {
            const r = 52;
            const c = 2 * Math.PI * r;
            ringFill.style.strokeDasharray = `${c}`;
            ringFill.style.strokeDashoffset = `${c * (1 - audit.scores.overall / 100)}`;
        }

        const bars: Array<[string, number]> = [
            ['Performance', audit.scores.performance],
            ['Accessibility', audit.scores.accessibility],
            ['Best Practices', audit.scores.bestPractices],
            ['SEO', audit.scores.seo],
        ];
        if (barsEl) {
            for (const [label, value] of bars) {
                const row = el('div', 'report-bar-row');
                row.appendChild(el('span', 'report-bar-label', label));
                const track = el('div', 'report-bar-track');
                const fill = el('div', 'report-bar-fill');
                fill.style.width = `${Math.max(0, Math.min(100, value))}%`;
                track.appendChild(fill);
                row.appendChild(track);
                row.appendChild(el('span', 'report-bar-value', String(value)));
                barsEl.appendChild(row);
            }
        }

        if (metaEl) {
            const items: Array<[string, string]> = [
                ['Response time', audit.metrics.ttfbMs + ' ms'],
                ['Page weight', fmtBytes(audit.metrics.contentLengthBytes)],
                ['Scripts', String(audit.metrics.scriptsCount)],
                ['Stylesheets', String(audit.metrics.stylesheetsCount)],
                ['Images', String(audit.metrics.imagesCount)],
                ['Images missing alt', String(audit.metrics.imagesMissingAltCount)],
                ['Links', String(audit.metrics.linksCount)],
                ['Scan time', audit.durationMs + ' ms'],
            ];
            for (const [k, v] of items) {
                const wrap = el('div', 'report-meta-item');
                wrap.appendChild(el('dt', 'report-meta-key', k));
                wrap.appendChild(el('dd', 'report-meta-val', v));
                metaEl.appendChild(wrap);
            }
        }

        if (headersEl) {
            for (const h of audit.security.headers) {
                const li = el('li', `report-header report-header--${h.status}`);
                li.appendChild(el('span', 'report-header-status', h.status));
                li.appendChild(el('span', 'report-header-name', h.name));
                if (h.value) li.appendChild(el('span', 'report-header-value', h.value));
                headersEl.appendChild(li);
            }
        }

        if (techEl) {
            if (audit.techStack.length === 0) {
                techEl.appendChild(el('p', 'report-tech-empty', 'No common technologies detected.'));
            } else {
                for (const t of audit.techStack) {
                    const chip = el('span', 'report-tech-chip');
                    chip.appendChild(el('span', 'report-tech-name', t.name));
                    chip.appendChild(el('span', 'report-tech-cat', t.category));
                    techEl.appendChild(chip);
                }
            }
        }

        if (findingsEl) {
            if (audit.findings.length === 0) {
                findingsEl.appendChild(el('p', 'report-findings-empty', 'No issues found. Every check passed.'));
            } else {
                for (const f of audit.findings) {
                    const li = el('li', `report-finding report-finding--${f.severity}`);
                    const head = el('div', 'report-finding-head');
                    head.appendChild(el('span', 'report-finding-sev', f.severity));
                    head.appendChild(el('span', 'report-finding-title', f.title));
                    li.appendChild(head);
                    li.appendChild(el('p', 'report-finding-desc', f.description));
                    if (f.recommendation) li.appendChild(el('p', 'report-finding-rec', f.recommendation));
                    findingsEl.appendChild(li);
                }
            }
        }
    }

    async function load() {
        if (!scanId) {
            showEmpty();
            return;
        }

        // Prefer the audit cached by the scan page (freshest, same tab).
        try {
            const cached = sessionStorage.getItem('whyknot_audit_' + scanId);
            if (cached) {
                render(JSON.parse(cached) as Audit);
                return;
            }
        } catch {
            // ignore malformed cache
        }

        let apiBase = '';
        try {
            apiBase = getApiBaseUrl();
        } catch {
            showEmpty();
            return;
        }

        try {
            const res = await fetch(`${apiBase}/api/screener/report/${encodeURIComponent(scanId)}`);
            const data = await res.json().catch(() => null);
            if (res.ok && data && data.ok && data.audit) {
                render(data.audit as Audit);
            } else {
                showEmpty();
            }
        } catch {
            showEmpty();
        }
    }

    load();
</script>
