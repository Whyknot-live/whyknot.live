---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const title = 'Scanning | WhyKnot Screener';
const description = 'Running a live technical audit of your website.';

const steps = [
    { id: 'fetch', name: 'Fetch Document', desc: 'Timing the server response and measuring payload weight.' },
    { id: 'tech', name: 'Fingerprint Stack', desc: 'Reading script assets and meta tags for framework signals.' },
    { id: 'audit', name: 'Run Audits', desc: 'Evaluating accessibility, security headers, and SEO metadata.' },
    { id: 'report', name: 'Build Report', desc: 'Calculating the composite score and remediation findings.' },
];
---

<Layout title={title} description={description}>
    <div class="screener-wrap">
        <Breadcrumbs trail={[{ label: 'Home', href: '/' }, { label: 'Screener', href: '/screener' }, { label: 'Scan' }]} />

        <section class="scan-shell" aria-labelledby="scan-title">
            <h1 id="scan-title" class="scan-title">Auditing your site</h1>
            <p class="scan-subtitle" id="scan-target"></p>

            <ol class="scan-steps" id="scan-steps">
                {steps.map((s) => (
                    <li class="scan-step" data-step={s.id}>
                        <span class="scan-step-dot" aria-hidden="true"></span>
                        <div class="scan-step-body">
                            <span class="scan-step-name">{s.name}</span>
                            <span class="scan-step-desc">{s.desc}</span>
                        </div>
                        <span class="scan-step-status" data-status>Waiting</span>
                    </li>
                ))}
            </ol>

            <p class="scan-log" id="scan-log" aria-live="polite">Starting the scan.</p>

            <div class="scan-error" id="scan-error" role="alert" hidden>
                <p class="scan-error-title">The scan could not complete.</p>
                <p class="scan-error-msg" id="scan-error-msg"></p>
                <a href="/screener" class="btn btn-secondary scan-error-back">Try another link</a>
            </div>
        </section>
    </div>
</Layout>

<script>
    import { getApiBaseUrl } from '../../lib/api-base';

    const params = new URLSearchParams(window.location.search);
    let targetUrl = params.get('url') ?? '';
    targetUrl = targetUrl.trim();

    const targetEl = document.getElementById('scan-target');
    const logEl = document.getElementById('scan-log');
    const errorEl = document.getElementById('scan-error');
    const errorMsgEl = document.getElementById('scan-error-msg');
    const stepEls = Array.from(document.querySelectorAll<HTMLElement>('[data-step]'));

    function normalizeInput(raw: string): string {
        let value = raw.trim();
        if (!value) return '';
        if (!/^https?:\/\//i.test(value)) {
            value = 'https://' + value;
        }
        return value;
    }

    function setStep(activeId: string) {
        let reachedActive = false;
        for (const el of stepEls) {
            const status = el.querySelector('[data-status]');
            if (el.dataset.step === activeId) {
                reachedActive = true;
                el.classList.add('is-active');
                if (status) status.textContent = 'Running';
            } else if (!reachedActive) {
                el.classList.add('is-done');
                if (status) status.textContent = 'Done';
            }
        }
    }

    function log(message: string) {
        if (logEl) logEl.textContent = message;
    }

    function fail(message: string) {
        if (logEl) logEl.hidden = true;
        if (errorMsgEl) errorMsgEl.textContent = message;
        if (errorEl) errorEl.hidden = false;
        for (const el of stepEls) {
            el.classList.remove('is-active');
            const status = el.querySelector('[data-status]');
            if (status && status.textContent === 'Running') status.textContent = 'Failed';
        }
    }

    async function run() {
        targetUrl = normalizeInput(targetUrl);
        if (!targetUrl) {
            window.location.href = '/screener';
            return;
        }
        if (targetEl) targetEl.textContent = targetUrl;

        let apiBase = '';
        try {
            apiBase = getApiBaseUrl();
        } catch {
            fail('The Screener is temporarily unavailable. Please try again later.');
            return;
        }

        try {
            setStep('fetch');
            log('Fetching the page and measuring response time.');

            const res = await fetch(`${apiBase}/api/screener/scan`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ url: targetUrl }),
            });

            const data = await res.json().catch(() => null);

            if (!res.ok || !data || !data.ok || !data.audit) {
                const message = (data && data.message) || 'The site could not be reached or analyzed.';
                fail(message);
                return;
            }

            const audit = data.audit;

            setStep('report');
            log('Scan complete. Opening the report.');

            try {
                sessionStorage.setItem('whyknot_audit_' + audit.scanId, JSON.stringify(audit));
            } catch {
                // sessionStorage may be unavailable; the report page refetches by id
            }

            setTimeout(() => {
                window.location.href = '/screener/report/' + audit.scanId;
            }, 400);
        } catch {
            fail('The Screener could not be reached. Please try again later.');
        }
    }

    run();
</script>
