---
/* /sites — the full catalogue, newest first. The index that /sites was missing:
   the route existed only as sites/[slug].astro, so the directory itself 404ed
   even on a correct deploy. */
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import SiteCard from '../../components/SiteCard.astro';
import { getFlatSites } from '../../lib/content';

const title = 'Sites | WhyKnot';
const description =
    'Every site in the WhyKnot library, newest first: innovative websites and tools worth your time.';

const sites = await getFlatSites();
const ordered = [...sites].sort(
    (a, b) => new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime(),
);
---

<Layout title={title} description={description} constrainContent>
    <div class="container section">
        <Breadcrumbs trail={[{ label: 'Sites' }]} />
        <SectionHeader
            eyebrow="The library"
            title="Sites"
            description={description}
        />
        <div class="card-grid" data-cols="3">
            {ordered.map((site) => (
                <SiteCard site={site} />
            ))}
        </div>
    </div>
</Layout>
