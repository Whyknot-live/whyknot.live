---
/* /topics/[slug] — wrapper over FacetPage; copy + matching in lib/facets.ts. */
import FacetPage from '../../components/FacetPage.astro';
import { FACETS } from '../../lib/facets';

const def = FACETS.topics;

export async function getStaticPaths() {
    const { FACETS: registry } = await import('../../lib/facets');
    return registry.topics.paths();
}

const { value, sites, description } = Astro.props;
---

<FacetPage def={def} value={value} sites={sites} slug={Astro.params.slug!} description={description} />
